{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../tools ../shared ../data ../chrome ../next-app",
  "redirects": [
    {
      "source": "/work-with-me.html",
      "destination": "/build-sprint.html",
      "permanent": true
    },
    {
      "source": "/work-with-fatiha.html",
      "destination": "/workshops.html",
      "permanent": true
    },
    {
      "source": "/guides/build-your-ai-learning-loop.html",
      "destination": "/guides/get-better-at-ai.html",
      "permanent": true
    },
    {
      "source": "/guides/tool-verdicts.html",
      "destination": "/guides/which-ai-tool-for-what.html",
      "permanent": true
    }
  ],
  "buildCommand": "cd .. && npm run publish:guides && node tools/include.mjs && node tools/proof-patches.mjs && node tools/site-positioning-patches.mjs && node tools/quiz-result-patch.mjs && node tools/brand-system-patch.mjs && node tools/density-patch.mjs && node tools/final-copy-polish.mjs",
  "outputDirectory": ".",
  "installCommand": "cd ../next-app && npm ci"
}
