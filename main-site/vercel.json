{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../tools ../shared ../data ../chrome ../next-app",
  "redirects": [
    {
      "source": "/work-with-me.html",
      "destination": "/build-sprint.html",
      "permanent": true
    },
    {
      "source": "/work-with-fatiha.html",
      "destination": "/workshops.html",
      "permanent": true
    },
    {
      "source": "/guides/build-your-ai-learning-loop.html",
      "destination": "/guides/get-better-at-ai.html",
      "permanent": true
    },
    {
      "source": "/guides/tool-verdicts.html",
      "destination": "/guides/which-ai-tool-for-what.html",
      "permanent": true
    }
  ],
  "buildCommand": "cd .. && npm run build:main-site",
  "outputDirectory": ".",
  "installCommand": "cd ../next-app && npm ci"
}
