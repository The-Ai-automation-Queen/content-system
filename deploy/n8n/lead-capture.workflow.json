    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ email: $json.body.email, locationId: 'REPLACE_WITH_GHL_LOCATION_ID', tags: [ $json.body.source || 'site' ], source: $json.body.source || 'site' }) }}"
