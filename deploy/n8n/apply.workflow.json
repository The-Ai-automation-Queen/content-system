    220,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "leftValue": "={{ $json.body._gotcha || '' }}",
       "rightValue": "",
       "operator": {
        "type": "string",
        "operation": "empty"
       }
      }
     ],
     "combinator": "and"
    }
   }
  },
  {
   "id": "ghl",
   "name": "GHL: upsert contact + tag",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    -80
   ],
   "parameters": {
    "method": "POST",
    "url": "https://services.leadconnectorhq.com/contacts/upsert",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Version",
       "value": "2021-07-28"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ email: $json.body.email, name: $json.body.name || '', locationId: 'REPLACE_WITH_GHL_LOCATION_ID', tags: [ ($json.body.source || '').indexOf('workshop') > -1 ? 'apply-workshop' : 'apply-build-sprint' ], source: $json.body.source || 'apply' }) }}"
   }
  },
  {
   "id": "opp",
   "name": "GHL: create opportunity",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    -80
   ],
   "parameters": {
    "method": "POST",
    "url": "https://services.leadconnectorhq.com/opportunities/",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Version",
       "value": "2021-07-28"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ pipelineId: 'REPLACE_WITH_PIPELINE_ID', pipelineStageId: 'REPLACE_WITH_NEW_APPLICATION_STAGE_ID', locationId: 'REPLACE_WITH_GHL_LOCATION_ID', contactId: $json.contact.id, name: ('Application: ' + ($('Webhook').item.json.body.name || $('Webhook').item.json.body.email)), status: 'open' }) }}"
   }
  },
  {
   "id": "ok",
   "name": "Respond: received",
   "type": "n8n-nodes-base.respondToWebhook",
   "typeVersion": 1.1,
   "position": [
    880,
    -80
   ],
   "parameters": {
    "respondWith": "text",
    "responseBody": "Application received. Fatiha reads every one and replies either way, usually within two working days.",
    "options": {
     "responseCode": 200
    }
   }
  },
  {
   "id": "silent",
   "name": "Respond ok (bot)",
