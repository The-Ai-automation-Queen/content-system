# Content OS — environment for the autonomous VPS runner.
# Copy this to deploy/.env and fill in the values you use.
# NEVER commit deploy/.env (it is git-ignored). See security.md §1.

# ─────────────────────────────────────────────────────────────
# Claude Code auth — pick ONE:
#   A) API-key billing: paste a key here.
#   B) Subscription (Max/Pro): leave this blank and run `claude login`
#      once on the VPS instead (interactive, one time).
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Gap 1 — Telegram failure/success alerts (mirrors Romain's alerts)
#   bot token: from @BotFather   ·   chat id: from @userinfobot
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Gap 2 — machine API keys. Paste only the ones you actually use.
# On your own VPS outbound traffic is open, so NO allowlisting is
# needed (that was only a Claude-web-sandbox restriction).
# ─────────────────────────────────────────────────────────────
HEYGEN_API_KEY=          # M02 talking-head of HER (skills/heygen) — the one paid tool worth it

# M03 long→shorts (skills/reels-factory): Reap is MCP-wired in the Claude env
# (no key here, virality-scored); Blotato is the free fallback. Nothing to set.

# M05 IG DM/lead capture (skills/dm-responder): handled by GoHighLevel natively —
# GHL catches the comment, sends the DM, captures + nurtures. Set GHL_API_KEY only
# if you want this skill to write leads into GHL directly (otherwise GHL does it).
GHL_API_KEY=             # optional — GoHighLevel (replaces ManyChat entirely)

# M05 LinkedIn DM automation (skills/dm-responder): Unipile connects to LinkedIn
# legally via your personal account. The Romain-pattern: auto-DM on comment keywords.
UNIPILE_API_KEY=         # from unipile.com after connecting your LinkedIn account
UNIPILE_DSN=             # Unipile data source name (provided during setup)

# ─────────────────────────────────────────────────────────────
# NOT NEEDED (save your money):
#   • ManyChat   → GoHighLevel does this; no ManyChat subscription.
#   • Opus Clip  → Blotato/Reap clip for free; no Opus Clip subscription.
#   • X / Twitter API → signal-harvester already scrapes X via Apify (MCP); no paid X API.
#   Apify / Tavily / Blotato / Canva / Gamma are MCP servers in the Claude env, not keys here.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=
