[Unit]
Description=AI Insider Brief Telegram approval bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/ai-insider-brief-pipeline
ExecStartPre=/usr/bin/test -s /root/ai-insider-brief-pipeline/.env
ExecStartPre=/usr/bin/node --check /root/ai-insider-brief-pipeline/approval-bot.mjs
ExecStart=/usr/bin/node /root/ai-insider-brief-pipeline/approval-bot.mjs
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
