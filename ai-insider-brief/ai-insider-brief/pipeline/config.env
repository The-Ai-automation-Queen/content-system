# Pipeline Configuration
CRAWL_INTERVAL_HOURS=12
MAX_CARDS_PER_RUN=5
MAX_CARDS_PER_DAY=8
APPROVAL_BATCH_SIZE=10
APPROVAL_BATCH_INTERVAL_MINUTES=15

# LLM Provider (ollama, openrouter, or gemini). The VPS Ollama subscription
# model is the quality default; no per-card API key is required.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:31b-cloud
GEMINI_MODEL=gemini-2.0-flash

# Optional stage overrides. Leave unset to keep every stage on Ollama.
# A low-API setup can keep filter/extraction local and use OpenRouter only
# for final judgment and verification after adding OPENROUTER_API_KEY to .env.
# JUDGMENT_LLM_PROVIDER=openrouter
# JUDGMENT_OPENROUTER_MODEL=openai/gpt-4.1-mini
# VERIFICATION_LLM_PROVIDER=openrouter
# VERIFICATION_OPENROUTER_MODEL=openai/gpt-4.1-mini

# Telegram (values loaded from C:\Secrets\)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Paths
BRIEFS_JSON_PATH=/var/www/ai-insider-brief/data/briefs.json
STATE_JSON_PATH=/root/ai-insider-brief-pipeline/state.json
SOURCES_JSON_PATH=/root/ai-insider-brief-pipeline/sources.json
PENDING_PATH=/root/ai-insider-brief-pipeline/cards-pending.json
PREVIEW_TRIGGER_PATH=/root/ai-insider-brief-pipeline/preview-trigger.json
