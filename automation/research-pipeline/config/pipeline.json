{
  "version": 2,
  "source_repository": "The-Ai-automation-Queen/research-inbox",
  "target_repository": "The-Ai-automation-Queen/content-system",
  "bootstrap_since": "2026-08-06",
  "max_items_per_hourly_watch": 20,
  "max_items_per_daily_factory": 40,
  "score_weights": {},
  "score_thresholds": {},
  "hard_blockers": [
    "unsupported_statistics_or_financial_claims",
    "single_weak_source_for_definitive_claim",
    "pure_tool_hype_without_business_outcome",
    "very_technical_topic_without_a_clear_business_translation",
    "duplicate_of_existing_guide_or_recent_draft",
    "outside_current_positioning",
    "stale_or_version_specific_instructions_without_reverification",
    "legal_or_security_claims_presented_as_advice_without_qualification"
  ],
  "routes": [
    "internal_research",
    "text_post",
    "carousel",
    "newsletter_draft",
    "article_draft",
    "guide_brief",
    "faceless_script",
    "presenter_script",
    "research_more"
  ],
  "guide_categories": [
    "save_time_with_ai",
    "think_and_create_better",
    "understand_your_data",
    "sell_and_market_better",
    "build_the_ai_help_you_need",
    "automate_and_scale",
    "choose_the_right_ai",
    "start_here_understand_ai"
  ],
  "guide_rules": {
    "guide_is_open": false,
    "email_before_access": true,
    "max_primary_ctas": 1
  },
  "funnel": {
    "authority": "Notion Product Hub / Brand Deals",
    "default": "no_conversion",
    "free_guides": "email_before_access",
    "paid_offers": "require_current_approval"
  },
  "approved_companion_asset_types": [
    "canvas",
    "checklist",
    "scorecard",
    "worksheet",
    "decision_tree",
    "template",
    "calculator",
    "personalised_result",
    "workflow_map"
  ],
  "publication_policy": {
    "internal_queue_updates_may_write_to_main": true,
    "full_guide_requires_draft_pr": true,
    "guide_update_requires_draft_pr": true,
    "lead_magnet_requires_draft_pr": true,
    "paid_product_requires_human_approval": true,
    "automation_may_merge_its_own_content_pr": false
  },
  "context_release": "context/current-context.json",
  "legacy_assessments": "superseded_until_reassessed",
  "dm_responder_enabled": false
}
