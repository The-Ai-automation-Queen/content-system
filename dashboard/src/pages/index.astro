---
import { getDashboard } from '../lib/data.js';

const tenant = Astro.url.searchParams.get('tenant') || 'root';
const d = getDashboard(tenant);

const MSTATUS = {
  live: { c: '#3fb950', t: 'LIVE' },
  partial: { c: '#d4a72c', t: 'PARTIAL' },
  'needs-key': { c: '#f85149', t: 'NEEDS KEY' },
  'needs-setup': { c: '#f85149', t: 'NEEDS SETUP' },
};

const FLAG_LABEL = {
  PERSONALIZE: 'Personalize',
  VERIFY: 'Verify a fact',
  PREP: 'Prep a resource',
  'NEEDS HER FACE': 'Needs her face',
  'NEEDS VISUAL': 'Needs visual',
};

const STATUSES = [
  { key: 'DRAFT', short: 'Draft', color: '#8b949e' },
  { key: 'READY TO POST', short: 'Ready', color: '#3fb950' },
  { key: 'SCHEDULED', short: 'Scheduled', color: '#d4a72c' },
  { key: 'POSTED', short: 'Posted', color: '#a371f7' },
];

const platformChip = (p) => (p || '').split('(')[0].trim();
const maxPillar = Math.max(1, ...d.pillars.map((p) => p.n));

const CRONS = [
  { machine: 'M01', name: 'Signal Harvester', schedule: 'Every day 02:00', retry: 'Retry 04:00', check: 'Verify 02:30' },
  { machine: 'M01', name: 'Content Engine', schedule: 'Weekly Mon 06:00', retry: 'Retry 08:00', check: 'Part of weekly-ops' },
  { machine: 'M05', name: 'DM Responder', schedule: 'Every 5 min', retry: 'Auto-restart', check: 'Continuous' },
];

const REPORT_META = {
  'research-digest': { label: 'Research sweep', icon: '🔎' },
  'competitor-watch': { label: 'Competitor watch', icon: '🛰️' },
  'vault-audit': { label: 'Vault audit', icon: '🩺' },
  'distribution': { label: 'Distribution', icon: '📤' },
  'architecture-analysis': { label: 'Architecture analysis', icon: '🏗️' },
};

const COSTS = [
  { tool: 'Claude Code', plan: 'Max ($200/mo)', type: 'Core', note: 'Powers the entire system' },
  { tool: 'Blotato', plan: 'Pro ($29/mo)', type: 'Publishing', note: 'Multi-platform queue + AI visuals' },
  { tool: 'Canva', plan: 'Pro ($13/mo)', type: 'Visual', note: 'Carousels, thumbnails' },
  { tool: 'SupaData', plan: 'Starter ($9/mo)', type: 'Research', note: 'Video transcripts' },
  { tool: 'HeyGen', plan: 'Creator ($29/mo)', type: 'Video', note: 'Talking-head avatar (optional)' },
  { tool: 'Apify', plan: 'Free tier', type: 'Research', note: 'Social scraping' },
  { tool: 'Tavily', plan: 'Free tier', type: 'Research', note: 'Web search' },
  { tool: 'GoHighLevel', plan: 'Starter ($97/mo)', type: 'Leads', note: 'DM responder + CRM' },
  { tool: 'VPS', plan: '~$10/mo', type: 'Hosting', note: 'Crons + webhook host' },
];

const totalCost = COSTS.reduce((s, c) => {
  const m = (c.plan || '').match(/\$(\d+)/);
  return s + (m ? parseInt(m[1]) : 0);
}, 0);

const dataPayload = JSON.stringify({ entries: d.entries, calendar: d.calendar, machines: d.machines });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content OS · The AI Automation Queen</title>
    <style>
      :root {
        --bg: #0c0f14; --sidebar: #111520; --panel: #161b25; --panel2: #1a2030;
        --line: #232b3a; --ink: #e6edf3; --mut: #9ca8bc; --gold: #d4a72c; --gold2: #f2c94c;
        --green: #3fb950; --blue: #58a6ff; --purple: #a371f7; --red: #f85149; --cyan: #39d2c0;
      }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--bg); color: var(--ink); font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; display: flex; height: 100vh; overflow: hidden; }
      a { color: var(--blue); text-decoration: none; }

      /* ── Sidebar ── */
      .sidebar { width: 220px; min-width: 220px; background: var(--sidebar); border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow-y: auto; }
      .sidebar .logo { padding: 20px 18px 16px; border-bottom: 1px solid var(--line); }
      .sidebar .logo h1 { font-size: 15px; font-weight: 700; letter-spacing: -0.3px; color: var(--gold2); }
      .sidebar .logo span { font-size: 11px; color: var(--mut); display: block; margin-top: 2px; }
      .sidebar nav { padding: 10px 8px; flex: 1; }
      .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; cursor: pointer; color: var(--mut); font-size: 13px; font-weight: 500; transition: all 0.12s; border: none; background: none; width: 100%; text-align: left; }
      .nav-item:hover { background: var(--panel); color: var(--ink); }
      .nav-item.active { background: var(--panel2); color: var(--gold2); border: 1px solid var(--line); }
      .nav-item .ico { font-size: 16px; width: 22px; text-align: center; }
      .nav-sep { height: 1px; background: var(--line); margin: 8px 12px; }
      .sidebar-foot { padding: 12px 14px; border-top: 1px solid var(--line); font-size: 11px; color: var(--mut); }

      /* ── Main ── */
      .main { flex: 1; overflow-y: auto; padding: 0; }
      .page { display: none; padding: 28px 32px 48px; }
      .page.active { display: block; }
      .page-head { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
      .page-head h2 { font-size: 20px; font-weight: 700; }
      .page-head .breadcrumb { font-size: 13px; color: var(--mut); }
      .page-head .breadcrumb span { color: var(--ink); }

      /* ── Dashboard / Cockpit ── */
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 28px; }
      .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
      .kpi .n { font-size: 28px; font-weight: 700; line-height: 1; }
      .kpi .l { color: var(--mut); font-size: 12px; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
      .kpi.gold .n { color: var(--gold2); } .kpi.green .n { color: var(--green); }
      .kpi.blue .n { color: var(--blue); } .kpi.purple .n { color: var(--purple); }
      .kpi.red .n { color: var(--red); }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
      @media (max-width: 900px) { .grid2 { grid-template-columns: 1fr; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin-bottom: 20px; }
      .panel h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--mut); margin-bottom: 14px; }

      /* ── Machines list ── */
      .m-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
      .m-card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; cursor: pointer; transition: all 0.15s; }
      .m-card:hover { border-color: var(--gold); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.3); }
      .m-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
      .m-dot { width: 10px; height: 10px; border-radius: 50%; }
      .m-name { font-weight: 600; font-size: 15px; flex: 1; }
      .m-id { font-size: 11px; color: var(--mut); font-family: monospace; }
      .m-note { color: var(--mut); font-size: 13px; line-height: 1.5; margin-bottom: 12px; }
      .m-foot { display: flex; justify-content: space-between; align-items: center; }
      .m-foot code { color: var(--blue); background: #141c28; padding: 3px 8px; border-radius: 6px; font-size: 12px; }
      .m-status { font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-size: 11px; }

      /* ── Machine detail view ── */
      .machine-detail { display: none; }
      .machine-detail.active { display: block; }
      .md-header { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
      .md-back { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; cursor: pointer; color: var(--mut); font-size: 13px; }
      .md-back:hover { border-color: var(--gold); color: var(--ink); }
      .md-title { font-size: 18px; font-weight: 700; }
      .md-subtitle { font-size: 13px; color: var(--mut); }

      .md-stats { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
      .md-stat { padding: 6px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; border: 1px solid; }

      /* ── Tabs ── */
      .tabs { display: flex; gap: 4px; margin-bottom: 18px; background: var(--panel); border-radius: 10px; padding: 4px; border: 1px solid var(--line); width: fit-content; }
      .tab { padding: 7px 16px; border-radius: 7px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--mut); background: none; border: none; transition: all 0.12s; }
      .tab:hover { color: var(--ink); }
      .tab.active { background: var(--gold); color: #000; }

      /* ── Calendar strip ── */
      .cal-strip { display: flex; gap: 6px; margin-bottom: 18px; overflow-x: auto; padding-bottom: 4px; }
      .cal-day { min-width: 52px; text-align: center; padding: 8px 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; transition: all 0.12s; flex-shrink: 0; }
      .cal-day:hover { border-color: var(--gold); }
      .cal-day.today { border-color: var(--gold); background: #221d10; }
      .cal-day.has-items { border-color: var(--green); }
      .cal-day .dow { font-size: 10px; color: var(--mut); text-transform: uppercase; }
      .cal-day .dom { font-size: 16px; font-weight: 700; margin-top: 2px; }
      .cal-day.today .dom { color: var(--gold2); }
      .cal-day .count-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); margin: 4px auto 0; }

      /* ── Filter chips ── */
      .filters { display: flex; gap: 6px; margin-bottom: 18px; flex-wrap: wrap; }
      .filter { padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; border: 1px solid var(--line); background: var(--panel); color: var(--mut); transition: all 0.12s; }
      .filter:hover { border-color: var(--gold); color: var(--ink); }
      .filter.active { background: var(--gold); color: #000; border-color: var(--gold); }
      .filter .cnt { opacity: 0.7; margin-left: 4px; }

      /* ── Content cards (entry list) ── */
      .entry-list { display: flex; flex-direction: column; gap: 8px; }
      .entry-card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; display: flex; align-items: flex-start; gap: 14px; transition: all 0.12s; }
      .entry-card:hover { border-color: #3a4560; }
      .entry-num { font-size: 12px; color: var(--gold2); background: #221d10; border: 1px solid #4a3d18; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-family: monospace; white-space: nowrap; margin-top: 2px; }
      .entry-body { flex: 1; min-width: 0; }
      .entry-title { font-weight: 600; font-size: 15px; line-height: 1.4; }
      .entry-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; align-items: center; }
      .chip { font-size: 12px; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
      .chip.cat { background: #141c28; color: var(--blue); border: 1px solid #1e3050; }
      .chip.plat { background: #1a1428; color: var(--purple); border: 1px solid #33244a; }
      .chip.score { background: #11261a; color: var(--green); border: 1px solid #1d3a23; }
      .chip.flag { background: #2a1413; color: var(--red); border: 1px solid #4a1f1d; }
      .chip.vis { background: #1c1430; color: var(--purple); border: 1px solid #33244a; }
      .entry-status { display: flex; gap: 4px; flex-shrink: 0; margin-top: 2px; }
      .sbtn { font: inherit; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 8px; background: #1a2030; color: var(--mut); border: 1px solid var(--line); cursor: pointer; transition: all 0.12s; }
      .sbtn:hover { border-color: var(--gold); color: var(--ink); }
      .sbtn.cur { background: var(--gold); color: #000; border-color: var(--gold2); }
      .sbtn:disabled { opacity: 0.4; cursor: wait; }

      /* ── Pillar bars ── */
      .pillar { margin-bottom: 12px; }
      .pillar .row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
      .bar { height: 6px; background: #1a2030; border-radius: 999px; overflow: hidden; }
      .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); border-radius: 999px; }

      /* ── Runs list ── */
      .runs { list-style: none; padding: 0; }
      .runs li { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
      .runs li:last-child { border-bottom: 0; }
      .runs .date { margin-left: auto; color: var(--mut); font-variant-numeric: tabular-nums; }

      /* ── Tables ── */
      .data-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .data-table th { text-align: left; padding: 10px 12px; color: var(--mut); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--line); }
      .data-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); }
      .data-table tr:last-child td { border-bottom: 0; }
      .data-table tr:hover td { background: var(--panel2); }

      /* ── Alerts ── */
      .attn-item { display: flex; gap: 10px; align-items: center; background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 8px; padding: 10px 12px; font-size: 14px; margin-bottom: 8px; }
      .attn-item .t { font-weight: 600; flex: 1; }

      /* ── Skill card ── */
      .skill-card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 14px; }
      .skill-card:hover { border-color: #3a4560; }
      .skill-name { font-weight: 700; font-size: 14px; color: var(--gold2); font-family: monospace; min-width: 180px; }
      .skill-desc { color: var(--mut); font-size: 13px; flex: 1; line-height: 1.4; }

      /* ── CLI block ── */
      .cli-block { background: #0a0e14; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; font-family: monospace; font-size: 14px; color: var(--green); margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; }
      .cli-label { font-size: 13px; color: var(--mut); margin-bottom: 6px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

      /* ── Channel row ── */
      .ch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

      /* ── Toast ── */
      .toast { position: fixed; bottom: 24px; right: 24px; background: var(--green); color: #000; font-weight: 700; padding: 12px 20px; border-radius: 10px; font-size: 14px; z-index: 999; display: none; box-shadow: 0 4px 20px rgba(63,185,80,0.3); }
      .toast.show { display: block; animation: slideUp 0.3s ease; }
      @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

      .empty { color: var(--mut); font-size: 14px; font-style: italic; padding: 12px 0; }
      .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
      .btn { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px; padding: 8px 14px; color: var(--ink); font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.12s; display: inline-flex; align-items: center; gap: 6px; }
      .btn:hover { border-color: var(--gold); text-decoration: none; }

      /* ── Architecture diagram ── */
      .arch-flow { display: flex; align-items: center; gap: 0; flex-wrap: wrap; margin: 20px 0; }
      .arch-node { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; text-align: center; min-width: 130px; }
      .arch-node .an-id { font-size: 11px; color: var(--gold2); font-weight: 700; font-family: monospace; }
      .arch-node .an-name { font-size: 13px; font-weight: 600; margin-top: 2px; }
      .arch-node .an-sub { font-size: 11px; color: var(--mut); margin-top: 2px; }
      .arch-arrow { color: var(--gold); font-size: 20px; padding: 0 6px; }
    </style>
  </head>
  <body>

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="logo">
        <h1>CONTENT OS</h1>
        <span>The AI Automation Queen</span>
      </div>
      <nav>
        <button class="nav-item active" data-page="dashboard"><span class="ico">📊</span> Dashboard</button>
        <button class="nav-item" data-page="brain"><span class="ico">🧠</span> Second Brain</button>
        <button class="nav-item" data-page="inventory"><span class="ico">📦</span> Inventory</button>
        <button class="nav-item" data-page="architecture"><span class="ico">🏗️</span> Architecture</button>
        <button class="nav-item" data-page="machines"><span class="ico">⚙️</span> Machines</button>
        <button class="nav-item" data-page="calendar"><span class="ico">📅</span> Calendar</button>
        <button class="nav-item" data-page="crons"><span class="ico">⏰</span> Crons</button>
        <div class="nav-sep"></div>
        <button class="nav-item" data-page="agents"><span class="ico">🤖</span> Agents</button>
        <button class="nav-item" data-page="costs"><span class="ico">💰</span> Costs</button>
        <button class="nav-item" data-page="cli"><span class="ico">💻</span> CLI</button>
        <div class="nav-sep"></div>
        <button class="nav-item" data-page="alerts"><span class="ico">🔔</span> Alerts</button>
        <button class="nav-item" data-page="settings"><span class="ico">⚡</span> Settings</button>
      </nav>
      <div class="sidebar-foot">
        tenant: <b>{d.tenant}</b><br>
        {new Date(d.generatedAt).toLocaleString()}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <div class="main">

      <!-- ════ PAGE: Dashboard ════ -->
      <div class="page active" id="p-dashboard">
        <div class="page-head">
          <h2>Dashboard</h2>
          <span class="breadcrumb">Content OS / <span>Overview</span></span>
        </div>

        <div class="kpis">
          <div class="kpi"><div class="n">{d.kpis.total}</div><div class="l">Total pieces</div></div>
          <div class="kpi green"><div class="n">{d.kpis.ready}</div><div class="l">Ready to post</div></div>
          <div class="kpi gold"><div class="n">{d.kpis.scheduled}</div><div class="l">Scheduled</div></div>
          <div class="kpi purple"><div class="n">{d.kpis.posted}</div><div class="l">Posted</div></div>
          <div class="kpi red"><div class="n">{d.kpis.flagged}</div><div class="l">Need input</div></div>
          <div class="kpi blue"><div class="n">{d.kpis.withVisual}</div><div class="l">With visual</div></div>
        </div>

        <div class="grid2">
          <div>
            <div class="panel">
              <h3>Content Pillars</h3>
              {d.pillars.map((p) => (
                <div class="pillar">
                  <div class="row"><span>{p.name}</span><span>{p.n}</span></div>
                  <div class="bar"><span style={`width:${(p.n / maxPillar) * 100}%`}></span></div>
                </div>
              ))}
            </div>
            <div class="panel">
              <h3>Needs Your Input</h3>
              {d.flagged.length === 0 && <div class="empty">Nothing blocked.</div>}
              {d.flagged.map((e) => (
                <div class="attn-item">
                  <span class="entry-num">#{e.num}</span>
                  <span class="t">{e.title}</span>
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                </div>
              ))}
            </div>
          </div>
          <div>
            <div class="panel">
              <h3>Recent Runs</h3>
              <ul class="runs">
                {d.reports.slice(0, 10).map((r) => {
                  const meta = REPORT_META[r.type] || { label: r.type, icon: '📄' };
                  return <li><span>{meta.icon}</span><span>{meta.label}</span><span class="date">{r.date}</span></li>;
                })}
                {d.reports.length === 0 && <li class="empty">No reports yet.</li>}
              </ul>
            </div>
            <div class="panel">
              <h3>Control Room</h3>
              <div style="color:var(--mut); font-size:14px; margin-bottom:10px">
                {d.researchCount} research entries · {d.leads.active}/{d.leads.total} lead magnets active
              </div>
              <div class="links">
                <a class="btn" href="https://my.blotato.com" target="_blank">📤 Blotato queue</a>
                <a class="btn" href="https://github.com/the-ai-automation-queen/content-system" target="_blank">🧠 GitHub</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Second Brain ════ -->
      <div class="page" id="p-brain">
        <div class="page-head">
          <h2>Second Brain</h2>
          <span class="breadcrumb">Content OS / <span>Vault &amp; Research</span></span>
        </div>

        <div class="md-stats">
          <span class="md-stat" style={`color:var(--green);border-color:#1d3a23;background:#11261a`}>Ready to Post <b>{d.kpis.ready}</b></span>
          <span class="md-stat" style={`color:var(--gold2);border-color:#4a3d18;background:#221d10`}>Scheduled <b>{d.kpis.scheduled}</b></span>
          <span class="md-stat" style={`color:var(--purple);border-color:#33244a;background:#1c1430`}>Posted <b>{d.kpis.posted}</b></span>
          <span class="md-stat" style={`color:#8b949e;border-color:var(--line);background:var(--panel)`}>Draft <b>{d.kpis.draft}</b></span>
        </div>

        <div class="filters" id="brain-filters">
          <button class="filter active" data-filter="all">All <span class="cnt">{d.entries.length}</span></button>
          {STATUSES.map((s) => {
            const cnt = d.entries.filter(e => e.status === s.key).length;
            return <button class="filter" data-filter={s.key}>{s.short} <span class="cnt">{cnt}</span></button>;
          })}
        </div>

        <div class="entry-list" id="brain-list">
          {d.entries.map((e) => (
