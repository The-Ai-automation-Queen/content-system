                      {p.views > 0 && (
                        <>
                          <div class="pc-views">{fmtNum(p.views)}</div>
                          <div class="pc-views-l">Views</div>
                        </>
                      )}
                      <div class="pc-stats">
                        <div class="pc-stat"><div class="pc-n">{fmtNum(p.likes)}</div><div class="pc-l">Likes</div></div>
                        <div class="pc-stat"><div class="pc-n">{fmtNum(p.comments)}</div><div class="pc-l">Comments</div></div>
                        <div class="pc-stat"><div class="pc-n">{fmtNum(p.views)}</div><div class="pc-l">Views</div></div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="empty">No top posts tracked yet. Run <code style="color:var(--electric)">/performance-tracker</code> to scrape engagement data.</div>
              )}
            </div>

            {d.performance.entries.length > 1 && (
              <div class="panel" style="margin-top:20px">
                <h3>History</h3>
                <table class="perf-table">
                  <thead><tr><th>Date</th><th class="num">Profiles tracked</th><th class="num">Top posts</th></tr></thead>
                  <tbody>
                    {d.performance.entries.slice(0, 10).map((pe) => (
                      <tr>
                        <td style="font-family:var(--mono);font-size:12px">{pe.date}</td>
                        <td class="num">{Object.keys(pe.profiles).length}</td>
                        <td class="num">{pe.topPosts.length}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        ) : (
          <div class="panel">
            <div style="text-align:center;padding:48px 24px">
              <div style="font-size:48px;margin-bottom:16px">📈</div>
              <div style="font-family:var(--serif);font-size:24px;margin-bottom:12px">No performance data yet</div>
              <div style="color:var(--mut);font-size:14px;max-width:420px;margin:0 auto;line-height:1.6">
                Run <code style="color:var(--electric);background:var(--cream);padding:2px 8px;border-radius:2px">claude -p "Run /performance-tracker"</code> to scrape follower counts and post engagement across all platforms.
              </div>
              <div class="cli-block" style="max-width:380px;margin:20px auto 0;justify-content:center">
                <span>claude -p "Run /performance-tracker"</span>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- ════ PAGE: Hooks ════ -->
      <div class="page" id="p-hooks">
        <div class="page-head">
          <h2>Hook Scorecard</h2>
          <span class="breadcrumb">Content OS / <span>Pattern usage across {d.entries.length} entries</span></span>
        </div>

        {d.hookScorecard.length > 0 ? (
          <>
            <div class="kpis" style="margin-bottom:28px">
              <div class="kpi purple"><div class="n">{d.hookScorecard.length}</div><div class="l">Patterns used</div></div>
              <div class="kpi green"><div class="n">{d.hookScorecard[0]?.count || 0}</div><div class="l">Top pattern uses</div></div>
              <div class="kpi"><div class="n">{d.entries.length}</div><div class="l">Total entries</div></div>
            </div>

            <div class="panel">
              <h3>Pattern usage</h3>
              {d.hookScorecard.map((h) => (
                <div class="hook-row">
                  <span class="hook-label" title={h.pattern}>{h.pattern}</span>
                  <div class="hook-bar-wrap"><span style={`width:${(h.count / maxHook) * 100}%`}></span></div>
                  <span class="hook-count">{h.count}</span>
                </div>
              ))}
            </div>

            <div class="panel" style="margin-top:20px">
              <h3>How to use more patterns</h3>
              <div style="color:var(--mut);font-size:14px;line-height:1.7">
                The <code style="color:var(--electric)">content-engine</code> skill pulls patterns from
                <code style="color:var(--electric)">inspiration-library/SKILL.md</code> (15 named patterns).
                Patterns with 0 uses are opportunities — tell the engine to prioritize them in the next batch.
              </div>
            </div>
          </>
        ) : (
          <div class="panel">
            <div style="text-align:center;padding:48px 24px">
              <div style="font-size:48px;margin-bottom:16px">🪝</div>
              <div style="font-family:var(--serif);font-size:24px;margin-bottom:12px">No hook patterns detected yet</div>
              <div style="color:var(--mut);font-size:14px;max-width:420px;margin:0 auto;line-height:1.6">
                Vault entries need a <b>Pattern used:</b> field. Run the content engine to generate entries with pattern tags.
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- ════ PAGE: Competitors ════ -->
      <div class="page" id="p-competitors">
        <div class="page-head">
          <h2>Competitors</h2>
          <span class="breadcrumb">Content OS / <span>Creator &amp; competitor intel</span></span>
        </div>

        {d.competitor.date ? (
          <>
            <div style="color:var(--mut); font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:24px;">
              Latest scan: {d.competitor.date}
            </div>

            {d.competitor.creators.length > 0 && (
              <>
                <div class="panel">
                  <h3>Creators ({d.competitor.creators.length})</h3>
                  <div class="creator-grid">
                    {d.competitor.creators.map((c) => (
                      <div class="creator-card">
                        <div class="cn">{c.name}</div>
                        <div class="ci">{c.insight}</div>
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )}

            <div class="grid2" style="margin-top:20px">
              {d.competitor.hooks.length > 0 && (
                <div class="panel">
                  <h3>Top hooks to adapt</h3>
                  <ul class="intel-list numbered">
                    {d.competitor.hooks.map((h) => <li>{h}</li>)}
                  </ul>
                </div>
              )}

              {d.competitor.gaps.length > 0 && (
                <div class="panel">
                  <h3>Gaps you could own</h3>
                  {d.competitor.gaps.map((g) => <div class="gap-item">{g}</div>)}
                </div>
              )}
            </div>
          </>
        ) : (
          <div class="panel">
            <div style="text-align:center;padding:48px 24px">
              <div style="font-size:48px;margin-bottom:16px">🔭</div>
              <div style="font-family:var(--serif);font-size:24px;margin-bottom:12px">No competitor data yet</div>
              <div style="color:var(--mut);font-size:14px;max-width:420px;margin:0 auto;line-height:1.6">
                Run <code style="color:var(--electric);background:var(--cream);padding:2px 8px;border-radius:2px">claude -p "Run /competitor-watch"</code> to scan creators and find hooks + gaps.
              </div>
              <div class="cli-block" style="max-width:380px;margin:20px auto 0;justify-content:center">
                <span>claude -p "Run /competitor-watch"</span>
              </div>
            </div>
          </div>
        )}
      </div>

    </div>

    <div class="toast" id="toast"></div>

    <!-- Data payload (safe JSON, avoids define:vars issues with special chars) -->
    <script id="app-data" type="application/json" set:html={dataPayload}></script>

    <script is:inline>
      const APP = JSON.parse(document.getElementById('app-data').textContent);
      const entries = APP.entries;
      const calendar = APP.calendar;
      const machines = APP.machines;

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2500);
      }

      // ── Sidebar navigation ──
      document.querySelectorAll('.nav-item[data-page]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
          document.getElementById('p-' + btn.dataset.page).classList.add('active');
        });
      });

      // ── Expand entry on click (toggle body preview) ──
      document.querySelectorAll('#brain-list .entry-card').forEach(card => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('.sbtn') || e.target.closest('.btn') || e.target.closest('textarea')) return;
          card.classList.toggle('open');
          card.classList.remove('editing');
          const saveBtn = card.querySelector('.save-btn');
          const cancelBtn = card.querySelector('.cancel-btn');
          const editBtn = card.querySelector('.edit-btn');
          if (saveBtn) saveBtn.style.display = 'none';
          if (cancelBtn) cancelBtn.style.display = 'none';
          if (editBtn) editBtn.style.display = '';
        });
      });

      // ── Edit / Save / Cancel entry body ──
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.entry-card');
          card.classList.add('editing');
          btn.style.display = 'none';
          card.querySelector('.save-btn').style.display = '';
          card.querySelector('.cancel-btn').style.display = '';
          card.querySelector('.entry-edit-area').focus();
        });
      });

      document.querySelectorAll('.cancel-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.entry-card');
          card.classList.remove('editing');
          btn.style.display = 'none';
          card.querySelector('.save-btn').style.display = 'none';
          card.querySelector('.edit-btn').style.display = '';
          const ta = card.querySelector('.entry-edit-area');
          ta.value = card.querySelector('.entry-expand pre').textContent;
        });
      });

      document.querySelectorAll('.save-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          btn.disabled = true;
          const num = btn.dataset.num;
          const card = btn.closest('.entry-card');
          const body = card.querySelector('.entry-edit-area').value;
          try {
            const r = await fetch('/api/edit', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num, body }),
            });
            const j = await r.json();
            if (j.ok) {
              showToast('Saved #' + num);
              card.querySelector('.entry-expand pre').textContent = body;
              card.classList.remove('editing');
              btn.style.display = 'none';
              card.querySelector('.cancel-btn').style.display = 'none';
              card.querySelector('.edit-btn').style.display = '';
            } else { alert('Save failed: ' + (j.error || 'unknown')); }
          } catch (err) { alert('Save failed: ' + err); }
          btn.disabled = false;
        });
      });

      // ── Brain filters ──
      document.querySelectorAll('#brain-filters .filter').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#brain-filters .filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.filter;
          document.querySelectorAll('#brain-list .entry-card').forEach(card => {
            card.style.display = (f === 'all' || card.dataset.entryStatus === f) ? 'flex' : 'none';
          });
        });
      });

      // ── Status buttons ──
      document.querySelectorAll('.sbtn').forEach(b => {
        b.addEventListener('click', async () => {
          if (b.classList.contains('cur')) return;
          b.disabled = true;
          try {
            const r = await fetch('/api/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }),
            });
            const j = await r.json();
            if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
            else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
          } catch (err) { alert('Failed: ' + err); b.disabled = false; }
        });
      });

      // ── Schedule → Blotato ──
      // Two-step on purpose, and scheduled rather than immediate. Blotato has no
      // draft state, and useNextFreeSlot against an empty queue posts instantly
      // with no undo — so the server requires a future scheduledTime and this UI
      // never offers "post now". First click previews, second click schedules.
      //
      // Default is tomorrow 09:00 Dubai (UTC+4), i.e. 05:00 UTC.
      function defaultSlot() {
        const d = new Date();
        d.setUTCDate(d.getUTCDate() + 1);
        d.setUTCHours(5, 0, 0, 0);
        // datetime-local wants local wall-clock, so offset it back.
        const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
        return local.toISOString().slice(0, 16);
      }

      function renderResult(panel, j) {
        const lines = [];
        lines.push(j.sent ? '✅ SCHEDULED ON BLOTATO' : '🔎 PREVIEW — nothing sent');
        if (j.reason) lines.push('why: ' + j.reason);
        if (j.target) lines.push('target: ' + j.target);
        if (j.timing) lines.push('timing: ' + j.timing);
        if (j.chars != null) lines.push('chars: ' + j.chars);
        if (j.gates) {
          const g = j.gates, tick = (b) => (b ? '✓' : '✗');
          lines.push('gates: ' + tick(g.blotatoLive) + ' BLOTATO_LIVE   ' +
                     tick(g.apiKeyPresent) + ' API key   ' +
                     tick(g.accountVerified) + ' account verified   ' +
                     tick(g.noBlockers) + ' no blockers');
        }
        (j.blockers || []).forEach(b => lines.push('BLOCKED: ' + b));
        (j.warnings || []).forEach(w => lines.push('warning: ' + w));
        if (j.error) lines.push('error: ' + j.error);
        lines.push('', 'payload for POST /v2/posts:', JSON.stringify(j.payload, null, 2));
        panel.textContent = lines.join('\n');
      }

      document.querySelectorAll('.approve-btn').forEach(btn => {
        btn.addEventListener('click', async (ev) => {
          ev.stopPropagation();
          const card = btn.closest('.entry-card');
          const num = btn.dataset.num;

          let wrap = card.querySelector('.approve-wrap');
          if (!wrap) {
            wrap = document.createElement('div');
            wrap.className = 'approve-wrap';
            wrap.innerHTML =
              '<div style="margin-top:12px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">' +
                '<label style="font-size:12px">Publish at </label>' +
                '<input type="datetime-local" class="sched-at" value="' + defaultSlot() + '" style="padding:4px">' +
                '<button class="btn sched-go" type="button">Schedule it</button>' +
                '<span class="sched-note" style="font-size:11px;color:var(--mut)"></span>' +
              '</div>' +
              '<pre class="approve-panel" style="margin-top:12px;padding:12px;border:1px solid var(--line);background:var(--bg);font-size:11px;white-space:pre-wrap;max-height:340px;overflow:auto"></pre>';
            card.querySelector('.entry-actions').after(wrap);

            wrap.querySelector('.sched-go').addEventListener('click', async (e2) => {
              e2.stopPropagation();
              const at = wrap.querySelector('.sched-at').value;
              if (!at) { wrap.querySelector('.sched-note').textContent = 'pick a time first'; return; }
              const go = wrap.querySelector('.sched-go');
              go.disabled = true;
              try {
                const r = await fetch('/api/publish', {
                  method: 'POST',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ num, scheduledTime: new Date(at).toISOString() }),
                });
                const j = await r.json();
                renderResult(wrap.querySelector('.approve-panel'), j);
                if (j.sent) { showToast('#' + num + ' scheduled'); setTimeout(() => location.reload(), 1200); }
                else go.disabled = false;
              } catch (err) {
                wrap.querySelector('.approve-panel').textContent = 'Failed: ' + err;
                go.disabled = false;
              }
            });
          }

          // First click: preview with the currently selected time, sending nothing.
          const panel = wrap.querySelector('.approve-panel');
          panel.textContent = 'Checking…';
          try {
            const at = wrap.querySelector('.sched-at').value;
            const r = await fetch('/api/publish', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num, scheduledTime: at ? new Date(at).toISOString() : undefined }),
            });
            renderResult(panel, await r.json());
          } catch (err) {
            panel.textContent = 'Failed: ' + err;
          }
        });
      });

      // ── Copy buttons ──
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(btn.dataset.copy).then(() => showToast('Copied!'));
        });
      });

      // ── Machine filter tabs ──
      document.querySelectorAll('#machine-filters .filter').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#machine-filters .filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.mfilter;
          document.querySelectorAll('.machine-group').forEach(g => {
            g.style.display = (f === 'all' || g.dataset.group === f) ? 'block' : 'none';
          });
        });
      });

      // ── Machine search ──
      document.getElementById('machine-search').addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('.m-card').forEach(card => {
          const text = (card.dataset.machineName + ' ' + card.dataset.machineNote + ' ' + card.dataset.machine).toLowerCase();
          card.style.display = text.includes(q) ? '' : 'none';
        });
        // Show group headers that have visible cards
        document.querySelectorAll('.machine-group').forEach(g => {
          const visibleCards = g.querySelectorAll('.m-card[style=""], .m-card:not([style])');
          const hasHidden = g.querySelectorAll('.m-card[style*="none"]').length;
          const total = g.querySelectorAll('.m-card').length;
          g.style.display = (total - hasHidden > 0 || !q) ? 'block' : 'none';
        });
      });

      // ── Machine detail ──
      const STATUSES = [
        { key: 'DRAFT', short: 'Draft', color: '#5C5A57' },
        { key: 'READY TO POST', short: 'Ready', color: '#1E8E5A' },
        { key: 'SCHEDULED', short: 'Scheduled', color: '#B26A00' },
        { key: 'POSTED', short: 'Posted', color: '#6B35C2' },
      ];

      document.querySelectorAll('.m-card').forEach(card => {
        card.addEventListener('click', () => {
          const skill = card.dataset.machine;
          const name = card.dataset.machineName;
          const id = card.dataset.machineId;
          const note = card.dataset.machineNote;

          document.getElementById('machines-grid').style.display = 'none';
          document.getElementById('machine-filters').style.display = 'none';
          document.getElementById('machine-search').parentElement.style.display = 'none';
          const detail = document.getElementById('machine-detail');
          detail.classList.add('active');

          document.getElementById('md-title').textContent = name;
          document.getElementById('md-subtitle').textContent = id + ' · ' + note;
          document.getElementById('md-cmd').textContent = 'claude -p "Run /' + skill + '"';

          const mEntries = entries;
          const byStatus = {};
          STATUSES.forEach(s => { byStatus[s.key] = mEntries.filter(e => e.status === s.key).length; });

          const statsEl = document.getElementById('md-stats');
          statsEl.innerHTML = STATUSES.map(s =>
            '<span class="md-stat" style="color:' + s.color + ';border-color:' + s.color + '33;background:' + s.color + '11">' + s.short + ' <b>' + byStatus[s.key] + '</b></span>'
          ).join('');

          const filtersEl = document.getElementById('md-filters');
          filtersEl.innerHTML = '<button class="filter active" data-mf="all">All <span class="cnt">' + mEntries.length + '</span></button>' +
            STATUSES.map(s => '<button class="filter" data-mf="' + s.key + '">' + s.short + ' <span class="cnt">' + byStatus[s.key] + '</span></button>').join('');

          renderMachineEntries(mEntries);

          filtersEl.querySelectorAll('.filter').forEach(btn => {
            btn.addEventListener('click', () => {
              filtersEl.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              const f = btn.dataset.mf;
              const filtered = f === 'all' ? mEntries : mEntries.filter(e => e.status === f);
              renderMachineEntries(filtered);
            });
          });

          const calStrip = document.getElementById('md-cal-strip');
          calStrip.innerHTML = calendar.map(c =>
            '<div class="cal-day ' + (c.isToday ? 'today' : '') + ' ' + (c.items.length ? 'has-items' : '') + '">' +
              '<div class="dow">' + c.dow + '</div>' +
              '<div class="dom">' + c.dom + '</div>' +
              (c.items.length ? '<div class="count-dot"></div>' : '') +
            '</div>'
          ).join('');
        });
      });

      function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function renderMachineEntries(list) {
        const el = document.getElementById('md-entries');
        if (list.length === 0) { el.innerHTML = '<div class="empty">No entries.</div>'; return; }
        el.innerHTML = list.map(e => {
          const title = escapeHtml(e.title);
          const plat = e.platform ? escapeHtml(e.platform.split('(')[0].trim()) : '';
          const pillar = e.pillar ? escapeHtml(e.pillar.split('(')[0].trim()) : '';
          const body = escapeHtml(e.body || '(no content yet)');
          return '<div class="entry-card" data-entry-num="' + escapeHtml(e.num) + '">' +
            '<span class="entry-num">#' + escapeHtml(e.num) + '</span>' +
            '<div class="entry-body">' +
              '<div class="entry-title">' + title + '</div>' +
              '<div class="entry-meta">' +
                (plat ? '<span class="chip plat">' + plat + '</span>' : '') +
                (pillar ? '<span class="chip cat">' + pillar + '</span>' : '') +
                (e.critic != null ? '<span class="chip score">' + e.critic.toFixed(1) + '</span>' : '') +
              '</div>' +
              '<div class="entry-expand">' +
                '<pre>' + body + '</pre>' +
                '<textarea class="entry-edit-area" data-num="' + escapeHtml(e.num) + '">' + escapeHtml(e.body || '') + '</textarea>' +
                '<div class="entry-actions">' +
                  '<button class="btn edit-btn" data-num="' + escapeHtml(e.num) + '">Edit</button>' +
                  '<button class="btn save save-btn" data-num="' + escapeHtml(e.num) + '" style="display:none">Save</button>' +
                  '<button class="btn cancel-btn" data-num="' + escapeHtml(e.num) + '" style="display:none">Cancel</button>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="entry-status">' +
              STATUSES.map(s => '<button class="sbtn ' + (e.status === s.key ? 'cur' : '') + '" data-num="' + escapeHtml(e.num) + '" data-status="' + s.key + '">' + s.short + '</button>').join('') +
            '</div>' +
          '</div>';
        }).join('');
        el.querySelectorAll('.sbtn').forEach(b => {
          b.addEventListener('click', async () => {
            if (b.classList.contains('cur')) return;
            b.disabled = true;
            try {
              const r = await fetch('/api/update', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }) });
              const j = await r.json();
              if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
              else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
            } catch (err) { alert('Failed: ' + err); b.disabled = false; }
          });
        });
        // Expand/edit handlers for machine detail entries
        el.querySelectorAll('.entry-card').forEach(card => {
          card.style.cursor = 'pointer';
          card.addEventListener('click', (ev) => {
            if (ev.target.closest('.sbtn') || ev.target.closest('.btn') || ev.target.closest('textarea')) return;
            card.classList.toggle('open');
            card.classList.remove('editing');
          });
        });
        el.querySelectorAll('.edit-btn').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const card = btn.closest('.entry-card');
            card.classList.add('editing');
            btn.style.display = 'none';
            card.querySelector('.save-btn').style.display = '';
            card.querySelector('.cancel-btn').style.display = '';
            card.querySelector('.entry-edit-area').focus();
          });
        });
        el.querySelectorAll('.cancel-btn').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const card = btn.closest('.entry-card');
            card.classList.remove('editing');
            btn.style.display = 'none';
            card.querySelector('.save-btn').style.display = 'none';
            card.querySelector('.edit-btn').style.display = '';
            card.querySelector('.entry-edit-area').value = card.querySelector('.entry-expand pre').textContent;
          });
        });
        el.querySelectorAll('.save-btn').forEach(btn => {
          btn.addEventListener('click', async (ev) => {
            ev.stopPropagation();
            btn.disabled = true;
            const num = btn.dataset.num;
            const card = btn.closest('.entry-card');
            const body = card.querySelector('.entry-edit-area').value;
            try {
              const r = await fetch('/api/edit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ num, body }) });
              const j = await r.json();
              if (j.ok) { showToast('Saved #' + num); card.querySelector('.entry-expand pre').textContent = body; card.classList.remove('editing'); btn.style.display = 'none'; card.querySelector('.cancel-btn').style.display = 'none'; card.querySelector('.edit-btn').style.display = ''; }
              else { alert('Save failed: ' + (j.error || 'unknown')); }
            } catch (err) { alert('Save failed: ' + err); }
            btn.disabled = false;
          });
        });
      }

      document.getElementById('md-back').addEventListener('click', () => {
        document.getElementById('machine-detail').classList.remove('active');
        document.getElementById('machines-grid').style.display = 'block';
        document.getElementById('machine-filters').style.display = 'flex';
        document.getElementById('machine-search').parentElement.style.display = 'block';
      });

      document.querySelectorAll('#md-tabs .tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('#md-tabs .tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          ['content', 'calendar', 'run'].forEach(t => {
            document.getElementById('md-tab-' + t).style.display = t === tab.dataset.tab ? 'block' : 'none';
          });
        });
      });

      // ── Night-mode toggle (persisted) ──
      (function () {
        const btn = document.getElementById('themeToggle');
        if (!btn) return;
        const ico = btn.querySelector('.tt-ico');
        const label = btn.querySelector('.tt-label');
        function paint() {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          ico.textContent = dark ? '☀️' : '🌙';
          label.textContent = dark ? 'Day mode' : 'Night mode';
        }
        paint();
        btn.addEventListener('click', () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (dark) {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('cos-theme', 'light'); } catch (e) {}
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('cos-theme', 'dark'); } catch (e) {}
          }
          paint();
        });
      })();
    </script>
  </body>
</html>