                <span style="color:var(--mut)">Check .env</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:14px">
                <span>GHL_API_KEY</span>
                <span style="color:var(--mut)">Optional</span>
              </div>
            </div>
          </div>
        </div>
        <div class="panel" style="margin-top:16px">
          <h3>Lead Magnets</h3>
          <p style="color:var(--mut);font-size:14px">{d.leads.active}/{d.leads.total} active</p>
          <div style="margin-top:10px;display:flex;flex-direction:column;gap:6px">
            {d.leads.rows.map((r) => (
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:14px;padding:6px 0;border-bottom:1px dashed var(--line)">
                <span><b>{r.keyword}</b> — {r.label}</span>
                <span style={`color:${r.active ? 'var(--green)' : 'var(--red)'};font-size:12px;font-weight:700`}>{r.active ? 'ACTIVE' : 'INACTIVE'}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <div class="toast" id="toast"></div>

    <!-- Data payload (safe JSON, avoids define:vars issues with special chars) -->
    <script id="app-data" type="application/json" set:html={dataPayload}></script>

    <script is:inline>
      const APP = JSON.parse(document.getElementById('app-data').textContent);
      const entries = APP.entries;
      const calendar = APP.calendar;
      const machines = APP.machines;

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2500);
      }

      // ── Sidebar navigation ──
      document.querySelectorAll('.nav-item[data-page]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
          document.getElementById('p-' + btn.dataset.page).classList.add('active');
        });
      });

      // ── Brain filters ──
      document.querySelectorAll('#brain-filters .filter').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#brain-filters .filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.filter;
          document.querySelectorAll('#brain-list .entry-card').forEach(card => {
            card.style.display = (f === 'all' || card.dataset.entryStatus === f) ? 'flex' : 'none';
          });
        });
      });

      // ── Status buttons ──
      document.querySelectorAll('.sbtn').forEach(b => {
        b.addEventListener('click', async () => {
          if (b.classList.contains('cur')) return;
          b.disabled = true;
          try {
            const r = await fetch('/api/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }),
            });
            const j = await r.json();
            if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
            else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
          } catch (err) { alert('Failed: ' + err); b.disabled = false; }
        });
      });

      // ── Copy buttons ──
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(btn.dataset.copy).then(() => showToast('Copied!'));
        });
      });

      // ── Machine detail ──
      const STATUSES = [
        { key: 'DRAFT', short: 'Draft', color: '#8b949e' },
        { key: 'READY TO POST', short: 'Ready', color: '#3fb950' },
        { key: 'SCHEDULED', short: 'Scheduled', color: '#d4a72c' },
        { key: 'POSTED', short: 'Posted', color: '#a371f7' },
      ];

      document.querySelectorAll('.m-card').forEach(card => {
        card.addEventListener('click', () => {
          const skill = card.dataset.machine;
          const name = card.dataset.machineName;
          const id = card.dataset.machineId;
          const note = card.dataset.machineNote;

          document.getElementById('machines-grid').style.display = 'none';
          const detail = document.getElementById('machine-detail');
          detail.classList.add('active');

          document.getElementById('md-title').textContent = name;
          document.getElementById('md-subtitle').textContent = id + ' · ' + note;
          document.getElementById('md-cmd').textContent = 'claude -p "Run /' + skill + '"';

          const mEntries = entries;
          const byStatus = {};
          STATUSES.forEach(s => { byStatus[s.key] = mEntries.filter(e => e.status === s.key).length; });

          const statsEl = document.getElementById('md-stats');
          statsEl.innerHTML = STATUSES.map(s =>
            '<span class="md-stat" style="color:' + s.color + ';border-color:' + s.color + '33;background:' + s.color + '11">' + s.short + ' <b>' + byStatus[s.key] + '</b></span>'
          ).join('');

          const filtersEl = document.getElementById('md-filters');
          filtersEl.innerHTML = '<button class="filter active" data-mf="all">All <span class="cnt">' + mEntries.length + '</span></button>' +
            STATUSES.map(s => '<button class="filter" data-mf="' + s.key + '">' + s.short + ' <span class="cnt">' + byStatus[s.key] + '</span></button>').join('');

          renderMachineEntries(mEntries);

          filtersEl.querySelectorAll('.filter').forEach(btn => {
            btn.addEventListener('click', () => {
              filtersEl.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              const f = btn.dataset.mf;
              const filtered = f === 'all' ? mEntries : mEntries.filter(e => e.status === f);
              renderMachineEntries(filtered);
            });
          });

          const calStrip = document.getElementById('md-cal-strip');
          calStrip.innerHTML = calendar.map(c =>
            '<div class="cal-day ' + (c.isToday ? 'today' : '') + ' ' + (c.items.length ? 'has-items' : '') + '">' +
              '<div class="dow">' + c.dow + '</div>' +
              '<div class="dom">' + c.dom + '</div>' +
              (c.items.length ? '<div class="count-dot"></div>' : '') +
            '</div>'
          ).join('');
        });
      });

      function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function renderMachineEntries(list) {
        const el = document.getElementById('md-entries');
        if (list.length === 0) { el.innerHTML = '<div class="empty">No entries.</div>'; return; }
        el.innerHTML = list.map(e => {
          const title = escapeHtml(e.title);
          const plat = e.platform ? escapeHtml(e.platform.split('(')[0].trim()) : '';
          const pillar = e.pillar ? escapeHtml(e.pillar.split('(')[0].trim()) : '';
          return '<div class="entry-card">' +
            '<span class="entry-num">#' + escapeHtml(e.num) + '</span>' +
            '<div class="entry-body">' +
              '<div class="entry-title">' + title + '</div>' +
              '<div class="entry-meta">' +
                (plat ? '<span class="chip plat">' + plat + '</span>' : '') +
                (pillar ? '<span class="chip cat">' + pillar + '</span>' : '') +
                (e.critic != null ? '<span class="chip score">' + e.critic.toFixed(1) + '</span>' : '') +
              '</div>' +
            '</div>' +
            '<div class="entry-status">' +
              STATUSES.map(s => '<button class="sbtn ' + (e.status === s.key ? 'cur' : '') + '" data-num="' + escapeHtml(e.num) + '" data-status="' + s.key + '">' + s.short + '</button>').join('') +
            '</div>' +
          '</div>';
        }).join('');
        el.querySelectorAll('.sbtn').forEach(b => {
          b.addEventListener('click', async () => {
            if (b.classList.contains('cur')) return;
            b.disabled = true;
            try {
              const r = await fetch('/api/update', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }) });
              const j = await r.json();
              if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
              else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
            } catch (err) { alert('Failed: ' + err); b.disabled = false; }
          });
        });
      }

      document.getElementById('md-back').addEventListener('click', () => {
        document.getElementById('machine-detail').classList.remove('active');
        document.getElementById('machines-grid').style.display = 'grid';
      });

      document.querySelectorAll('#md-tabs .tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('#md-tabs .tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          ['content', 'calendar', 'run'].forEach(t => {
            document.getElementById('md-tab-' + t).style.display = t === tab.dataset.tab ? 'block' : 'none';
          });
        });
      });
    </script>
  </body>
</html>
