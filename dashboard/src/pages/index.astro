---
import { getDashboard } from '../lib/data.js';

const tenant = Astro.url.searchParams.get('tenant') || 'root';
const d = getDashboard(tenant);
const MSTATUS = {
  live: { c: '#3fb950', t: 'live' },
  partial: { c: '#d4a72c', t: 'partial' },
  'needs-key': { c: '#f85149', t: 'needs key' },
  'needs-setup': { c: '#f85149', t: 'needs setup' },
};

const REPORT_META = {
  'research-digest': { label: 'Research sweep', icon: '🔎' },
  'competitor-watch': { label: 'Competitor watch', icon: '🛰️' },
  'vault-audit': { label: 'Vault audit', icon: '🩺' },
  'distribution': { label: 'Distribution', icon: '📤' },
};

const FLAG_LABEL = {
  PERSONALIZE: 'Personalize',
  VERIFY: 'Verify a fact',
  PREP: 'Prep a resource',
  'NEEDS HER FACE': 'Needs her face',
  'NEEDS VISUAL': 'Needs visual',
};

const maxPillar = Math.max(1, ...d.pillars.map((p) => p.n));
const platformChip = (p) => (p || '').split('(')[0].trim();
const STATUSES = [
  { key: 'DRAFT', short: 'Draft' },
  { key: 'READY TO POST', short: 'Ready' },
  { key: 'SCHEDULED', short: 'Sched' },
  { key: 'POSTED', short: 'Posted' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mission Control · The AI Automation Queen</title>
    <style>
      :root {
        --bg: #0d1117; --panel: #161b22; --panel2: #1c2230; --line: #2a3140;
        --ink: #e6edf3; --mut: #9aa7b6; --gold: #d4a72c; --gold2: #f2c94c;
        --green: #3fb950; --blue: #58a6ff; --purple: #a371f7; --red: #f85149;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: radial-gradient(1200px 600px at 80% -10%, #1a2030 0, var(--bg) 55%);
        color: var(--ink); font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        padding: 28px clamp(16px, 4vw, 48px) 64px;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 4px; }
      h1 { font-size: clamp(22px, 3vw, 30px); margin: 0; letter-spacing: -0.4px; }
      .crown { color: var(--gold2); }
      .sub { color: var(--mut); margin: 2px 0 26px; }
      .sub b { color: var(--ink); font-weight: 600; }

      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 30px; }
      .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
      .kpi .n { font-size: 30px; font-weight: 700; line-height: 1; }
      .kpi .l { color: var(--mut); font-size: 12.5px; margin-top: 7px; text-transform: uppercase; letter-spacing: 0.5px; }
      .kpi.gold .n { color: var(--gold2); } .kpi.green .n { color: var(--green); }
      .kpi.blue .n { color: var(--blue); } .kpi.purple .n { color: var(--purple); }
      .kpi.red .n { color: var(--red); }

      h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--mut); margin: 34px 0 14px; }

      .board { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .col { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }
      .col h3 { margin: 0 0 12px; font-size: 13px; display: flex; align-items: center; gap: 8px; }
      .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
      .col .count { margin-left: auto; color: var(--mut); font-weight: 600; }
      .card { background: var(--panel2); border: 1px solid var(--line); border-radius: 11px; padding: 11px 12px; margin-bottom: 10px; }
      .card:last-child { margin-bottom: 0; }
      .card .t { font-weight: 600; font-size: 14px; }
      .card .meta { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 9px; }
      .chip { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: #20283a; color: var(--mut); border: 1px solid var(--line); white-space: nowrap; }
      .chip.entry { color: var(--gold2); border-color: #4a3d18; background: #221d10; }
      .chip.score { color: var(--green); border-color: #1d3a23; background: #11261a; }
      .chip.score.low { color: var(--gold2); }
      .chip.flag { color: var(--red); border-color: #4a1f1d; background: #2a1413; }
      .chip.vis { color: var(--purple); border-color: #33244a; background: #1c1430; }
      .empty { color: var(--mut); font-size: 13px; font-style: italic; padding: 6px 2px; }

      .grid2 { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 22px; align-items: start; }
      @media (max-width: 820px) { .grid2 { grid-template-columns: 1fr; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }

      .pillar { margin-bottom: 12px; }
      .pillar .row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
      .bar { height: 8px; background: #20283a; border-radius: 999px; overflow: hidden; }
      .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); }

      .runs { list-style: none; padding: 0; margin: 0; }
      .runs li { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 13.5px; }
      .runs li:last-child { border-bottom: 0; }
      .runs .date { margin-left: auto; color: var(--mut); font-variant-numeric: tabular-nums; }

      .attn { display: flex; flex-direction: column; gap: 10px; }
      .attn .item { display: flex; gap: 10px; align-items: center; background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 9px; padding: 9px 11px; font-size: 13.5px; }
      .attn .item .t { font-weight: 600; }

      .links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
      .btn { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 14px; color: var(--ink); font-weight: 600; font-size: 13.5px; }
      .btn:hover { border-color: var(--gold); text-decoration: none; }
      .actions { display: flex; gap: 4px; margin-top: 9px; flex-wrap: wrap; }
      .sbtn { font: inherit; font-size: 10.5px; padding: 3px 8px; border-radius: 7px; background: #1a2030; color: var(--mut); border: 1px solid var(--line); cursor: pointer; }
      .sbtn:hover { border-color: var(--gold); color: var(--ink); }
      .sbtn.cur { background: #221d10; color: var(--gold2); border-color: #4a3d18; cursor: default; }
      .sbtn:disabled { opacity: 0.5; cursor: wait; }
      .tenants { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }
      .tchip { font-size: 12px; padding: 4px 11px; border-radius: 999px; background: var(--panel); color: var(--mut); border: 1px solid var(--line); }
      .tchip.cur { color: var(--gold2); border-color: #4a3d18; background: #221d10; }
      .tchip:hover { text-decoration: none; border-color: var(--gold); }
      .machines { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
      .machine { background: var(--panel); border: 1px solid var(--line); border-radius: 13px; padding: 14px; }
      .mhead { display: flex; align-items: center; gap: 8px; }
      .mdot { width: 9px; height: 9px; border-radius: 50%; }
      .mname { font-weight: 600; font-size: 14px; }
      .mid { margin-left: auto; font-size: 10.5px; color: var(--mut); font-family: ui-monospace, monospace; }
      .mnote { color: var(--mut); font-size: 12.5px; margin: 9px 0 11px; line-height: 1.45; min-height: 34px; }
      .mfoot { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; }
      .mfoot code { color: var(--blue); background: #18202e; padding: 2px 7px; border-radius: 6px; }
      .mstatus { font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-size: 10.5px; }
      footer { color: var(--mut); font-size: 12px; margin-top: 40px; }
    </style>
  </head>
  <body>
    <header>
      <h1><span class="crown">👑</span> Mission Control</h1>
      <span class="sub" style="margin:0">The AI Automation Queen · content Business OS</span>
      <span class="tenants">
        {d.tenants.map((t) => (
          <a class={`tchip ${ (tenant === t || (tenant === 'root' && t === 'root')) ? 'cur' : ''}`} href={t === 'root' ? '/' : `/?tenant=${t}`}>{t === 'root' ? 'Fatiha' : t}</a>
        ))}
      </span>
    </header>
    <p class="sub">
      Live view of the <b>second brain</b> — the markdown files <i>are</i> the database.
      The agent loop (research → draft → visual → queue) writes here; <b>click a status on any
      card</b> to move it through the pipeline yourself.
    </p>

    <div class="kpis">
      <div class="kpi"><div class="n">{d.kpis.total}</div><div class="l">Total pieces</div></div>
      <div class="kpi green"><div class="n">{d.kpis.ready}</div><div class="l">Ready to post</div></div>
      <div class="kpi gold"><div class="n">{d.kpis.scheduled}</div><div class="l">Scheduled</div></div>
      <div class="kpi purple"><div class="n">{d.kpis.posted}</div><div class="l">Posted</div></div>
      <div class="kpi"><div class="n">{d.kpis.draft}</div><div class="l">Drafts</div></div>
      <div class="kpi red"><div class="n">{d.kpis.flagged}</div><div class="l">Need your input</div></div>
      <div class="kpi blue"><div class="n">{d.kpis.withVisual}</div><div class="l">With visual</div></div>
    </div>

    <h2>The Engine — 5 machines</h2>
    <div class="machines">
      {d.machines.map((m) => {
        const s = MSTATUS[m.status] || MSTATUS.partial;
        return (
          <div class="machine">
            <div class="mhead">
              <span class="mdot" style={`background:${s.c}`}></span>
              <span class="mname">{m.name}</span>
              <span class="mid">{m.id}</span>
            </div>
            <div class="mnote">{m.note}</div>
            <div class="mfoot"><code>{m.skill}</code><span class="mstatus" style={`color:${s.c}`}>{s.t}</span></div>
          </div>
        );
      })}
    </div>

    <h2>Pipeline</h2>
    <div class="board">
      {d.columns.map((col) => (
        <div class="col">
          <h3><span class="dot" style={`background:${col.color}`}></span>{col.label}<span class="count">{col.items.length}</span></h3>
          {col.items.length === 0 && <div class="empty">Nothing here.</div>}
          {col.items.map((e) => (
            <div class="card">
              <div class="t">{e.title}</div>
              <div class="meta">
                <span class="chip entry">#{e.num}</span>
                {platformChip(e.platform) && <span class="chip">{platformChip(e.platform)}</span>}
                {e.pillar && <span class="chip">{e.pillar.split('(')[0].trim()}</span>}
                {e.critic != null && <span class={`chip score ${e.critic < 8 ? 'low' : ''}`}>{e.critic.toFixed(1)}</span>}
                {e.hasVisual && (e.visualUrl ? <a class="chip vis" href={e.visualUrl} target="_blank">🎬 visual</a> : <span class="chip vis">🎬 visual</span>)}
                {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
              </div>
              <div class="actions">
                {STATUSES.map((s) => (
                  <button class={`sbtn ${e.status === s.key ? 'cur' : ''}`} data-num={e.num} data-status={s.key}>{s.short}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="grid2">
      <div>
        <h2>Needs your input</h2>
        <div class="panel">
          {d.flagged.length === 0 && <div class="empty">Nothing blocked — everything's clear to move. 🎉</div>}
          <div class="attn">
            {d.flagged.map((e) => (
              <div class="item">
                <span class="chip entry">#{e.num}</span>
                <span class="t">{e.title}</span>
                <span style="margin-left:auto; display:flex; gap:6px; flex-wrap:wrap">
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                </span>
              </div>
            ))}
          </div>
        </div>

        <h2>Content pillars</h2>
        <div class="panel">
          {d.pillars.map((p) => (
            <div class="pillar">
              <div class="row"><span>{p.name}</span><span>{p.n}</span></div>
              <div class="bar"><span style={`width:${(p.n / maxPillar) * 100}%`}></span></div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2>Recent runs (audit trail)</h2>
        <div class="panel">
          <ul class="runs">
            {d.reports.slice(0, 12).map((r) => {
              const meta = REPORT_META[r.type] || { label: r.type, icon: '📄' };
              return (
                <li><span>{meta.icon}</span><span>{meta.label}</span><span class="date">{r.date}</span></li>
              );
            })}
            {d.reports.length === 0 && <li class="empty">No reports yet.</li>}
          </ul>
        </div>

        <h2>Control room</h2>
        <div class="panel">
          <div style="color:var(--mut); font-size:13.5px">
            {d.researchCount} research entries · {d.kpis.withVisual} with a visual ·
            {d.leads.active}/{d.leads.total} lead magnets active · tenant: <b>{d.tenant}</b>
          </div>
          <div class="links">
            <a class="btn" href="https://my.blotato.com" target="_blank">📤 Blotato queue</a>
            <a class="btn" href="https://github.com/the-ai-automation-queen/content-system" target="_blank">🧠 GitHub repo</a>
          </div>
        </div>
      </div>
    </div>

    <footer>
      Generated {new Date(d.generatedAt).toLocaleString()} · reads <code>content-vault.md</code>,
      <code>reports/</code>, <code>research-notes.md</code> · refresh the page after an agent run.
    </footer>
    <script type="module">
      for (const b of document.querySelectorAll('.sbtn')) {
        b.addEventListener('click', async () => {
          if (b.classList.contains('cur')) return;
          b.disabled = true;
          try {
            const r = await fetch('/api/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }),
            });
            const j = await r.json();
            if (j.ok) location.reload();
            else { alert('Update failed: ' + (j.error || 'unknown')); b.disabled = false; }
          } catch (err) { alert('Update failed: ' + err); b.disabled = false; }
        });
      }
    </script>
  </body>
</html>
