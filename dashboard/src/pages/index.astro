---
import { getDashboard } from '../lib/data.js';

const tenant = Astro.url.searchParams.get('tenant') || 'root';
const d = getDashboard(tenant);

const MSTATUS = {
  live: { c: '#1E8E5A', t: 'LIVE' },
  partial: { c: '#B26A00', t: 'PARTIAL' },
  'needs-key': { c: '#E63955', t: 'NEEDS KEY' },
  'needs-setup': { c: '#E63955', t: 'NEEDS SETUP' },
};

const FLAG_LABEL = {
  PERSONALIZE: 'Personalize',
  VERIFY: 'Verify a fact',
  PREP: 'Prep a resource',
  'NEEDS HER FACE': 'Needs her face',
  'NEEDS VISUAL': 'Needs visual',
};

const STATUSES = [
  { key: 'DRAFT', short: 'Draft', color: '#5C5A57' },
  { key: 'READY TO POST', short: 'Ready', color: '#1E8E5A' },
  { key: 'SCHEDULED', short: 'Scheduled', color: '#B26A00' },
  { key: 'POSTED', short: 'Posted', color: '#6B35C2' },
  { key: 'STALE', short: 'Stale', color: '#B0483A' },
  { key: 'KILLED', short: 'Killed', color: '#8A8580' },
];

const platformChip = (p) => (p || '').split('(')[0].trim();

// One color per status, used on the card edge and the active status button.
// "Everything has the same color codes" (operator, 30/07) — it did: .sbtn.cur
// was the same ink-black for every status.
const STATUS_COLOR = Object.fromEntries(STATUSES.map((s) => [s.key, s.color]));

// Old-format entries mix the post with production sections (### SPOKEN SCRIPT,
// ### CAPTION, ### SLIDES, ### LINKEDIN POST). Rendered as one <pre> they read
// as one confusing blob. Split into labeled sections instead.
function bodySections(body) {
  const parts = (body || '').split(/^### (.+)$/m);
  const out = [];
  if (parts[0] && parts[0].trim()) out.push({ label: null, text: parts[0].trim() });
  for (let i = 1; i < parts.length; i += 2) {
    out.push({ label: parts[i].trim(), text: (parts[i + 1] || '').trim() });
  }
  return out.length ? out : [{ label: null, text: '' }];
}
const maxPillar = Math.max(1, ...d.pillars.map((p) => p.n));

const CRONS = [
  { machine: 'M01', name: 'Signal Harvester', schedule: 'Every day 02:00', retry: 'Retry 04:00', check: 'Verify 02:30' },
  { machine: 'M01', name: 'Content Engine', schedule: 'Weekly Mon 06:00', retry: 'Retry 08:00', check: 'Part of weekly-ops' },
  { machine: 'M05', name: 'DM Responder', schedule: 'Every 5 min', retry: 'Auto-restart', check: 'Continuous' },
  { machine: 'M06', name: 'Performance Tracker', schedule: 'Every day 03:00', retry: 'Retry 05:00', check: 'Verify 03:30' },
];

const REPORT_META = {
  'research-digest': { label: 'Research sweep', icon: '🔎' },
  'competitor-watch': { label: 'Competitor watch', icon: '🛰️' },
  'vault-audit': { label: 'Vault audit', icon: '🩺' },
  'distribution': { label: 'Distribution', icon: '📤' },
  'architecture-analysis': { label: 'Architecture analysis', icon: '🏗️' },
};

const COSTS = [
  { tool: 'Claude Code', plan: 'Max ($200/mo)', type: 'Core', note: 'Powers the entire system' },
  { tool: 'Blotato', plan: 'Pro ($29/mo)', type: 'Publishing', note: 'Multi-platform queue + AI visuals + narrated video' },
  { tool: 'Canva', plan: 'Pro ($13/mo)', type: 'Visual', note: 'Carousels, thumbnails' },
  { tool: 'Gamma', plan: 'Free tier', type: 'Visual', note: 'Decks / presentations' },
  { tool: 'SupaData', plan: 'Starter ($9/mo)', type: 'Research', note: 'Video transcripts' },
  { tool: 'Higgsfield', plan: 'Paid (TBD)', type: 'Video', note: 'Talking-head avatar of HER (primary)' },
  { tool: 'HeyGen', plan: 'Creator ($29/mo)', type: 'Video', note: 'Talking-head avatar (fallback)' },
  { tool: 'Reap', plan: 'Free tier', type: 'Video', note: 'Long → shorts with virality scoring (MCP)' },
  { tool: 'Apify', plan: 'Free tier', type: 'Research', note: 'Social scraping (IG/X/YouTube)' },
  { tool: 'Tavily', plan: 'Free tier', type: 'Research', note: 'Web search' },
  { tool: 'GoHighLevel', plan: 'Starter ($97/mo)', type: 'Leads', note: 'DM responder + CRM (replaces ManyChat)' },
  { tool: 'VPS', plan: '~$10/mo', type: 'Hosting', note: 'Crons + webhook host' },
];

const totalCost = COSTS.reduce((s, c) => {
  const m = (c.plan || '').match(/\$(\d+)/);
  return s + (m ? parseInt(m[1]) : 0);
}, 0);

// Icon + accent per skill (Romain-style colored icon tiles)
const SKILL_ICON = {
  'signal-harvester': '📡', 'content-engine': '✍️', 'visual-engine': '🎨',
  'heygen': '🎬', 'reels-factory': '🎞️', 'distribution': '📤', 'dm-responder': '💬',
  'weekly-ops': '🔄', 'vault-audit': '🩺', 'competitor-watch': '🔭', 'supadata-transcript': '📝', 'performance-tracker': '📈',
};
const GROUP_COLOR = {
  'REELS (INSTAGRAM / TIKTOK)': '#E63955',
  'LINKEDIN': '#2C4BE0',
  'YOUTUBE': '#E63955',
  'X (TWITTER)': '#1A1A1A',
  'CROSS-PLATFORM': '#6B35C2',
  'SYSTEM': '#1B2EA0',
};

// Machine groups + filter tabs
const machineGroups = [...new Set(d.machines.map((m) => m.group))];
const liveCount = d.machines.filter((m) => m.status === 'live').length;
const buildCount = d.machines.filter((m) => m.status !== 'live').length;

const dataPayload = JSON.stringify({ entries: d.entries.map(e => ({...e, body: e.body || ''})), calendar: d.calendar, machines: d.machines });

// Intelligence panels
const perfLatest = d.performance.latest;
const perfTopPosts = perfLatest
  ? [...perfLatest.topPosts]
      .sort((a, b) => (b.likes + b.comments + b.views) - (a.likes + a.comments + a.views))
      .slice(0, 5)
  : [];
const perfProfiles = perfLatest ? Object.entries(perfLatest.profiles) : [];
const maxHook = Math.max(1, ...d.hookScorecard.map((h) => h.count));
const PLAT_LABELS = {
  instagram: 'IG', ig: 'IG', youtube: 'YT', yt: 'YT',
  tiktok: 'TikTok', linkedin: 'LinkedIn', facebook: 'FB', fb: 'FB',
  x: 'X', twitter: 'X',
};
const platLabel = (k) => PLAT_LABELS[k] || k;
const fmtNum = (n) => n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K' : String(n);
const truncate = (s, len = 40) => s.length > len ? s.slice(0, len) + '...' : s;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content OS · The AI Automation Queen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,700&family=Source+Serif+4:ital,wght@0,400;0,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style is:global>
      /* ════ Shift & Lead brand system — light editorial ════ */
      :root {
        --canvas: #F8F7F5; --cream: #F4F0FA; --accent-tint: #EEE5FA;
        --accent: #6B35C2; --accent-deep: #4A1F8F; --electric: #2C4BE0; --navy: #1B2EA0;
        /* mapped to existing class names so everything inherits the brand */
        --bg: #F8F7F5; --sidebar: #FFFFFF; --panel: #FFFFFF; --panel2: #F4F0FA;
        --line: #D8D6D2; --ink: #1A1A1A; --mut: #5C5A57;
        --gold: #6B35C2; --gold2: #4A1F8F;
        --green: #1E8E5A; --blue: #2C4BE0; --purple: #6B35C2; --red: #E63955; --cyan: #1B2EA0;
        --amber: #B26A00; --term: #1A1A1A;
        --mono: 'Space Mono', ui-monospace, monospace;
        --serif: 'Playfair Display', Georgia, serif;
        --ui: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      /* ════ Night theme — comfortable dark for after-dark viewing ════ */
      [data-theme="dark"] {
        --canvas: #131019; --cream: #1C1726; --accent-tint: #271D3D;
        --accent: #A371F7; --accent-deep: #C8A6FF; --electric: #6E8BFF; --navy: #93A4FF;
        --bg: #131019; --sidebar: #181321; --panel: #1B1626; --panel2: #241D33;
        --line: #322A42; --ink: #ECE6F3; --mut: #A99FC0;
        --gold: #A371F7; --gold2: #C8A6FF;
        --green: #5BD68A; --blue: #6E8BFF; --purple: #A371F7; --red: #FF6B7E; --cyan: #93A4FF;
        --amber: #E0A040; --term: #0E0B14;
        color-scheme: dark;
      }
      [data-theme="dark"] .m-icon { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14); }
      [data-theme="dark"] .chip { color: #15111E; }

      /* Theme toggle button */
      .theme-toggle { display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 12px; padding: 8px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 2px; color: var(--ink); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: all 0.12s; }
      .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
      .theme-toggle .tt-ico { font-size: 13px; }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--bg); color: var(--ink); font: 15px/1.6 var(--ui); display: flex; height: 100vh; overflow: hidden; -webkit-font-smoothing: antialiased; }
      a { color: var(--accent); text-decoration: none; }

      /* ── Sidebar ── */
      .sidebar { width: 230px; min-width: 230px; background: var(--sidebar); border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow-y: auto; }
      .sidebar .logo { padding: 22px 20px 18px; border-bottom: 1px solid var(--line); }
      .sidebar .logo h1 { font-family: var(--serif); font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
      .sidebar .logo span { font-family: var(--mono); font-size: 10px; color: var(--accent-deep); display: block; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.16em; }
      .sidebar nav { padding: 12px 10px; flex: 1; }
      .nav-item { display: flex; align-items: center; gap: 11px; padding: 10px 12px; border-radius: 4px; cursor: pointer; color: var(--muted, #5C5A57); font-family: var(--ui); font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.07em; transition: all 0.12s; border: none; background: none; width: 100%; text-align: left; }
      .nav-item:hover { background: var(--cream); color: var(--ink); }
      .nav-item.active { background: var(--accent-tint); color: var(--accent-deep); box-shadow: inset 3px 0 0 var(--accent); font-weight: 600; }
      .nav-item .ico { font-size: 15px; width: 20px; text-align: center; }
      .nav-sep { height: 1px; background: var(--line); margin: 10px 12px; }
      .nav-section { font-family: var(--mono); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--mut); padding: 16px 14px 6px; }
      .sidebar-foot { padding: 14px 16px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; line-height: 1.8; }

      /* ── Main ── */
      .main { flex: 1; overflow-y: auto; padding: 0; }
      .page { display: none; padding: 32px 40px 56px; max-width: 1280px; }
      .page.active { display: block; }
      .page-head { margin-bottom: 28px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
      .page-head h2 { font-family: var(--serif); font-size: 38px; font-weight: 400; letter-spacing: -0.01em; line-height: 1.1; }
      .page-head .breadcrumb { font-family: var(--mono); font-size: 11px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.16em; margin-top: 8px; display: block; }
      .page-head .breadcrumb span { color: var(--accent-deep); }

      /* ── KPIs ── */
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 32px; }
      .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; }
      .kpi .n { font-family: var(--serif); font-size: 40px; font-weight: 400; line-height: 1; color: var(--ink); }
      .kpi .l { color: var(--mut); font-family: var(--mono); font-size: 10px; margin-top: 10px; text-transform: uppercase; letter-spacing: 0.14em; }
      .kpi.gold .n { color: var(--accent); } .kpi.green .n { color: var(--green); }
      .kpi.blue .n { color: var(--electric); } .kpi.purple .n { color: var(--accent); }
      .kpi.red .n { color: var(--red); }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      @media (max-width: 900px) { .grid2 { grid-template-columns: 1fr; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 24px; margin-bottom: 24px; }
      .panel h3 { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent-deep); margin-bottom: 18px; }

      /* ── Machines ── */
      .m-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
      .m-card { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; cursor: pointer; transition: all 0.15s; }
      .m-card:hover { border-color: var(--accent); background: rgba(107,53,194,0.03); }
      .m-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
      .m-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; color: #fff; }
      .m-headtext { flex: 1; min-width: 0; }
      .m-name { font-family: var(--serif); font-weight: 500; font-size: 18px; line-height: 1.2; }
      .m-id { font-family: var(--mono); font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 2px; }
      .m-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      .m-note { color: var(--mut); font-size: 14px; line-height: 1.5; margin-bottom: 16px; font-family: 'Source Serif 4', Georgia, serif; }
      .m-foot { display: flex; justify-content: space-between; align-items: center; }
      .m-foot code { color: var(--electric); background: var(--cream); padding: 4px 9px; border-radius: 2px; font-family: var(--mono); font-size: 11px; }
      .m-status { font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 10px; }

      /* ── Machine detail view ── */
      .machine-detail { display: none; }
      .machine-detail.active { display: block; }
      .md-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
      .md-back { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 8px 14px; cursor: pointer; color: var(--ink); font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; }
      .md-back:hover { border-color: var(--accent); color: var(--accent); }
      .md-title { font-family: var(--serif); font-size: 26px; font-weight: 400; }
      .md-subtitle { font-size: 13px; color: var(--mut); }

      .md-stats { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
      .md-stat { padding: 8px 16px; border-radius: 2px; font-family: var(--mono); font-size: 12px; font-weight: 700; border: 1px solid; text-transform: uppercase; letter-spacing: 0.06em; }

      /* ── Tabs ── */
      .tabs { display: flex; gap: 0; margin-bottom: 20px; border: 1px solid var(--line); width: fit-content; }
      .tab { padding: 9px 20px; cursor: pointer; font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mut); background: var(--panel); border: none; border-right: 1px solid var(--line); transition: all 0.12s; }
      .tab:last-child { border-right: none; }
      .tab:hover { color: var(--ink); }
      .tab.active { background: var(--ink); color: var(--canvas); }

      /* ── Calendar strip ── */
      .cal-strip { display: flex; gap: 8px; margin-bottom: 18px; overflow-x: auto; padding-bottom: 4px; }
      .cal-day { min-width: 54px; text-align: center; padding: 10px 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 2px; cursor: pointer; transition: all 0.12s; flex-shrink: 0; }
      .cal-day:hover { border-color: var(--accent); }
      .cal-day.today { border-color: var(--accent); background: var(--accent-tint); }
      .cal-day.has-items { border-color: var(--green); }
      .cal-day .dow { font-family: var(--mono); font-size: 9px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; }
      .cal-day .dom { font-family: var(--serif); font-size: 20px; font-weight: 400; margin-top: 2px; }
      .cal-day.today .dom { color: var(--accent-deep); }
      .cal-day .count-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); margin: 4px auto 0; }

      /* ── Filter pills ── */
      .filters { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
      .filter { padding: 8px 14px; border-radius: 2px; font-family: var(--ui); font-size: 13px; font-weight: 500; cursor: pointer; border: 1px solid var(--line); background: var(--panel); color: var(--ink); transition: all 0.12s; }
      .filter:hover { border-color: var(--accent); }
      .filter.active { background: var(--ink); color: var(--canvas); border-color: var(--ink); }
      .filter .cnt { opacity: 0.6; margin-left: 4px; font-variant-numeric: tabular-nums; }

      /* ── Content cards (entry list) ── */
      .entry-list { display: flex; flex-direction: column; gap: 0; }
      .entry-card { background: var(--panel); border-bottom: 1px solid var(--line); padding: 20px 4px; display: flex; align-items: flex-start; gap: 16px; transition: all 0.12s; cursor: pointer; }
      .entry-card:hover { background: rgba(107,53,194,0.04); }
      .entry-expand { display: none; margin-top: 14px; }
      .entry-card.open .entry-expand { display: block; }
      .entry-expand pre { white-space: pre-wrap; font-family: 'Source Serif 4', Georgia, serif; font-size: 14px; line-height: 1.7; color: var(--ink); background: var(--cream); border: 1px solid var(--line); border-radius: 4px; padding: 16px; max-height: 400px; overflow-y: auto; }
      .entry-edit-area { width: 100%; min-height: 200px; font-family: 'Source Serif 4', Georgia, serif; font-size: 14px; line-height: 1.7; color: var(--ink); background: var(--canvas); border: 1px solid var(--accent); border-radius: 4px; padding: 16px; resize: vertical; display: none; }
      .entry-card.editing .entry-edit-area { display: block; }
      .entry-card.editing .entry-expand pre { display: none; }
      .entry-actions { display: flex; gap: 8px; margin-top: 10px; }
      .entry-actions .btn { font-size: 12px; padding: 6px 14px; }
      .entry-actions .btn.save { background: var(--green); color: #fff; border-color: var(--green); }
      .entry-actions .btn.save:hover { background: #167a4a; }
      .entry-num { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--accent-deep); background: var(--accent-tint); padding: 4px 8px; border-radius: 2px; white-space: nowrap; margin-top: 2px; }
      .entry-body { flex: 1; min-width: 0; }
      .entry-title { font-family: var(--serif); font-weight: 400; font-size: 20px; line-height: 1.25; }
      .entry-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; align-items: center; }
      .chip { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 9px; border-radius: 2px; white-space: nowrap; color: #fff; }
      .chip.cat { background: var(--accent); }
      .chip.plat { background: var(--electric); }
      .chip.score { background: var(--green); }
      .chip.flag { background: var(--red); }
      .chip.vis { background: var(--navy); }
      .entry-status { display: flex; gap: 6px; flex-shrink: 0; margin-top: 2px; }
      .sbtn { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 7px 11px; border-radius: 2px; background: var(--panel); color: var(--mut); border: 1px solid var(--line); cursor: pointer; transition: all 0.12s; }
      .sbtn:hover { border-color: var(--accent); color: var(--accent); }
      /* Current status takes its own status color, set inline per button. */
      .sbtn.cur { background: var(--sc, var(--ink)); color: #fff; border-color: var(--sc, var(--ink)); }
      .body-sec { margin-bottom: 14px; }
      .body-sec-label { font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-deep); background: var(--accent-tint); display: inline-block; padding: 3px 8px; border-radius: 2px; margin-bottom: 6px; }
      .sbtn:disabled { opacity: 0.4; cursor: wait; }

      /* ── Pillar bars ── */
      .pillar { margin-bottom: 14px; }
      .pillar .row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px; }
      .bar { height: 6px; background: var(--cream); border-radius: 999px; overflow: hidden; }
      .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--electric)); border-radius: 999px; }

      /* ── Runs list ── */
      .runs { list-style: none; padding: 0; }
      .runs li { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
      .runs li:last-child { border-bottom: 0; }
      .runs .date { margin-left: auto; color: var(--mut); font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }

      /* ── Tables ── */
      .data-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .data-table th { text-align: left; padding: 12px; color: var(--mut); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; border-bottom: 1px solid var(--line); }
      .data-table td { padding: 12px; border-bottom: 1px solid var(--line); }
      .data-table tr:last-child td { border-bottom: 0; }
      .data-table tr:hover td { background: rgba(107,53,194,0.04); }
      .data-table code { font-family: var(--mono); font-size: 12px; color: var(--electric); }

      /* ── Alerts ── */
      .attn-item { display: flex; gap: 12px; align-items: center; background: var(--cream); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 2px; padding: 12px 14px; font-size: 14px; margin-bottom: 10px; }
      .attn-item .t { font-weight: 600; flex: 1; }

      /* ── Skill card ── */
      .skill-card { background: var(--panel); border-bottom: 1px solid var(--line); padding: 16px 4px; display: flex; align-items: center; gap: 16px; }
      .skill-card:hover { background: rgba(107,53,194,0.04); }
      .skill-name { font-family: var(--mono); font-weight: 700; font-size: 13px; color: var(--accent-deep); min-width: 190px; }
      .skill-desc { color: var(--mut); font-size: 14px; flex: 1; line-height: 1.5; font-family: 'Source Serif 4', Georgia, serif; }

      /* ── CLI block (intentionally dark — terminal) ── */
      .cli-block { background: var(--term); border-radius: 2px; padding: 13px 16px; font-family: var(--mono); font-size: 13px; color: #8FE0B0; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; }
      .cli-label { font-family: var(--mono); font-size: 10px; color: var(--mut); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.12em; }

      /* ── Channel dot ── */
      .ch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

      /* ── Toast ── */
      .toast { position: fixed; bottom: 24px; right: 24px; background: var(--ink); color: var(--canvas); font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 12px; padding: 14px 22px; border-radius: 2px; z-index: 999; display: none; box-shadow: 0 8px 28px rgba(0,0,0,0.18); }
      .toast.show { display: block; animation: slideUp 0.3s ease; }
      @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

      /* ── Intelligence pages ── */
      .perf-profiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 28px; }
      .perf-chip { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; text-align: center; }
      .perf-chip .pn { font-family: var(--serif); font-size: 40px; font-weight: 400; color: var(--accent-deep); line-height: 1; }
      .perf-chip .pl { font-family: var(--mono); font-size: 9px; color: var(--mut); margin-top: 10px; text-transform: uppercase; letter-spacing: 0.14em; }
      .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
      .post-card { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; transition: all 0.12s; }
      .post-card:hover { border-color: var(--accent); }
      .post-card .pc-title { font-family: var(--serif); font-size: 16px; font-weight: 400; line-height: 1.3; margin-bottom: 12px; min-height: 42px; }
      .post-card .pc-plat { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--electric); margin-bottom: 14px; }
      .post-card .pc-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
      .post-card .pc-stat { text-align: center; }
      .post-card .pc-stat .pc-n { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--ink); }
      .post-card .pc-stat .pc-l { font-family: var(--mono); font-size: 9px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 2px; }
      .post-card .pc-views { font-family: var(--serif); font-size: 32px; font-weight: 400; color: var(--accent-deep); margin-bottom: 2px; }
      .post-card .pc-views-l { font-family: var(--mono); font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
      .perf-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .perf-table th { text-align: left; color: var(--mut); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; padding: 12px; border-bottom: 1px solid var(--line); }
      .perf-table td { padding: 12px; border-bottom: 1px solid var(--line); }
      .perf-table tr:last-child td { border-bottom: 0; }
      .perf-table tr:hover td { background: rgba(107,53,194,0.04); }
      .perf-table .num { text-align: right; font-variant-numeric: tabular-nums; }

      .creator-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-bottom: 28px; }
      .creator-card { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; transition: all 0.12s; }
      .creator-card:hover { border-color: var(--accent); }
      .creator-card .cn { font-family: var(--serif); font-weight: 400; font-size: 18px; color: var(--ink); margin-bottom: 8px; }
      .creator-card .ci { color: var(--mut); font-size: 14px; line-height: 1.6; font-family: 'Source Serif 4', Georgia, serif; }
      .intel-list { list-style: none; padding: 0; margin: 0; }
      .intel-list li { padding: 12px 0; border-bottom: 1px dashed var(--line); font-size: 14px; line-height: 1.6; }
      .intel-list li:last-child { border-bottom: 0; }
      .intel-list.numbered { counter-reset: il; }
      .intel-list.numbered li::before { counter-increment: il; content: counter(il) ". "; color: var(--accent-deep); font-weight: 700; font-family: var(--mono); }
      .gap-item { background: linear-gradient(90deg, rgba(30,142,90,0.08) 0%, transparent 100%); border-left: 3px solid var(--green); border-radius: 0 4px 4px 0; padding: 14px 18px; margin-bottom: 10px; font-size: 14px; line-height: 1.6; }
      .gap-item:last-child { margin-bottom: 0; }

      .hook-row { display: flex; align-items: center; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
      .hook-row:last-child { border-bottom: 0; }
      .hook-label { min-width: 220px; font-size: 14px; }
      .hook-bar-wrap { flex: 1; height: 10px; background: var(--cream); border-radius: 999px; overflow: hidden; }
      .hook-bar-wrap > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--electric)); border-radius: 999px; }
      .hook-count { min-width: 36px; text-align: right; font-family: var(--mono); font-size: 14px; font-weight: 700; color: var(--accent-deep); font-variant-numeric: tabular-nums; }

      .empty { color: var(--mut); font-size: 14px; font-style: italic; padding: 12px 0; }
      .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
      .btn { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 10px 16px; color: var(--ink); font-family: var(--ui); font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.12s; display: inline-flex; align-items: center; gap: 6px; }
      .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

      /* ── Architecture diagram ── */
      .arch-flow { display: flex; align-items: stretch; gap: 0; flex-wrap: nowrap; margin: 20px 0; overflow-x: auto; padding-bottom: 8px; }
      .arch-node { flex: 0 0 auto; background: var(--cream); border: 1px solid var(--line); border-radius: 4px; padding: 16px 20px; text-align: center; min-width: 140px; display: flex; flex-direction: column; justify-content: center; }
      .arch-node .an-id { font-family: var(--mono); font-size: 10px; color: var(--accent-deep); font-weight: 700; letter-spacing: 0.1em; }
      .arch-node .an-name { font-family: var(--serif); font-size: 16px; font-weight: 400; margin-top: 6px; color: var(--ink); }
      .arch-node .an-sub { font-family: var(--mono); font-size: 9px; color: var(--mut); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.1em; }
      .arch-arrow { flex: 0 0 auto; display: flex; align-items: center; color: var(--accent); font-size: 22px; padding: 0 10px; }
    </style>
    <script is:inline>
      // Apply saved theme before paint to avoid a flash of light at night.
      (function () {
        try {
          var t = localStorage.getItem('cos-theme');
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="logo">
        <h1>CONTENT OS</h1>
        <span>The AI Automation Queen</span>
      </div>
      <nav>
        <button class="nav-item active" data-page="dashboard"><span class="ico">📊</span> Dashboard</button>
        <button class="nav-item" data-page="brain"><span class="ico">🧠</span> Second Brain</button>
        <button class="nav-item" data-page="inventory"><span class="ico">📦</span> Inventory</button>
        <button class="nav-item" data-page="architecture"><span class="ico">🏗️</span> Architecture</button>
        <button class="nav-item" data-page="machines"><span class="ico">⚙️</span> Machines</button>
        <button class="nav-item" data-page="calendar"><span class="ico">📅</span> Calendar</button>
        <button class="nav-item" data-page="crons"><span class="ico">⏰</span> Crons</button>
        <div class="nav-section">Content</div>
        <button class="nav-item" data-page="performance"><span class="ico">📈</span> Performance</button>
        <button class="nav-item" data-page="hooks"><span class="ico">🪝</span> Hooks</button>
        <button class="nav-item" data-page="competitors"><span class="ico">🔭</span> Competitors</button>
        <div class="nav-section">System</div>
        <button class="nav-item" data-page="agents"><span class="ico">🤖</span> Agents</button>
        <button class="nav-item" data-page="costs"><span class="ico">💰</span> Costs</button>
        <button class="nav-item" data-page="cli"><span class="ico">💻</span> CLI</button>
        <button class="nav-item" data-page="alerts"><span class="ico">🔔</span> Alerts</button>
        <button class="nav-item" data-page="settings"><span class="ico">⚡</span> Settings</button>
      </nav>
      <div class="sidebar-foot">
        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle night mode">
          <span class="tt-ico">🌙</span><span class="tt-label">Night mode</span>
        </button>
        tenant: <b>{d.tenant}</b><br>
        {new Date(d.generatedAt).toLocaleString()}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <div class="main">

      <!-- ════ PAGE: Dashboard ════ -->
      <div class="page active" id="p-dashboard">
        <div class="page-head">
          <h2>Dashboard</h2>
          <span class="breadcrumb">Content OS / <span>Overview</span></span>
        </div>

        <div class="kpis">
          <div class="kpi"><div class="n">{d.kpis.total}</div><div class="l">Total pieces</div></div>
          <div class="kpi green"><div class="n">{d.kpis.ready}</div><div class="l">Ready to post</div></div>
          <div class="kpi gold"><div class="n">{d.kpis.scheduled}</div><div class="l">Scheduled</div></div>
          <div class="kpi purple"><div class="n">{d.kpis.posted}</div><div class="l">Posted</div></div>
          <div class="kpi red"><div class="n">{d.kpis.flagged}</div><div class="l">Need input</div></div>
          <div class="kpi blue"><div class="n">{d.kpis.withVisual}</div><div class="l">With visual</div></div>
        </div>

        <div class="grid2">
          <div>
            <div class="panel">
              <h3>Content Pillars</h3>
              {d.pillars.map((p) => (
                <div class="pillar">
                  <div class="row"><span>{p.name}</span><span>{p.n}</span></div>
                  <div class="bar"><span style={`width:${(p.n / maxPillar) * 100}%`}></span></div>
                </div>
              ))}
            </div>
            <div class="panel">
              <h3>Needs Your Input</h3>
              {d.flagged.length === 0 && <div class="empty">Nothing blocked.</div>}
              {d.flagged.map((e) => (
                <div class="attn-item">
                  <span class="entry-num">#{e.num}</span>
                  <span class="t">{e.title}</span>
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                </div>
              ))}
            </div>
          </div>
          <div>
            <div class="panel">
              <h3>Recent Runs</h3>
              <ul class="runs">
                {d.reports.slice(0, 10).map((r) => {
                  const meta = REPORT_META[r.type] || { label: r.type, icon: '📄' };
                  return <li><span>{meta.icon}</span><span>{meta.label}</span><span class="date">{r.date}</span></li>;
                })}
                {d.reports.length === 0 && <li class="empty">No reports yet.</li>}
              </ul>
            </div>
            <div class="panel">
              <h3>Control Room</h3>
              <div style="color:var(--mut); font-size:14px; margin-bottom:10px">
                {d.researchCount} research entries · {d.leads.active}/{d.leads.total} lead magnets active
              </div>
              <div class="links">
                <a class="btn" href="https://my.blotato.com" target="_blank">📤 Blotato queue</a>
                <a class="btn" href="https://github.com/the-ai-automation-queen/content-system" target="_blank">🧠 GitHub</a>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- ════ PAGE: Second Brain ════ -->
      <div class="page" id="p-brain">
        <div class="page-head">
          <h2>Second Brain</h2>
          <span class="breadcrumb">Content OS / <span>Vault &amp; Research</span></span>
        </div>

        <div class="md-stats">
          <span class="md-stat" style={`color:var(--green);border-color:var(--green);background:transparent`}>Ready to Post <b>{d.kpis.ready}</b></span>
          <span class="md-stat" style={`color:var(--amber);border-color:var(--amber);background:transparent`}>Scheduled <b>{d.kpis.scheduled}</b></span>
          <span class="md-stat" style={`color:var(--accent);border-color:var(--accent);background:var(--accent-tint)`}>Posted <b>{d.kpis.posted}</b></span>
          <span class="md-stat" style={`color:var(--mut);border-color:var(--line);background:var(--cream)`}>Draft <b>{d.kpis.draft}</b></span>
        </div>

        <div class="filters" id="brain-filters">
          <button class="filter active" data-filter="all">All <span class="cnt">{d.entries.length}</span></button>
          {STATUSES.map((s) => {
            const cnt = d.entries.filter(e => e.status === s.key).length;
            return <button class="filter" data-filter={s.key}>{s.short} <span class="cnt">{cnt}</span></button>;
          })}
        </div>

        <div class="entry-list" id="brain-list">
          {d.entries.map((e) => (
            <div class="entry-card" data-entry-status={e.status} data-entry-num={e.num}
                 style={`border-left: 3px solid ${STATUS_COLOR[e.status] || 'var(--line)'}; padding-left: 12px;`}>
              <span class="entry-num">#{e.num}</span>
              <div class="entry-body">
                <div class="entry-title">{e.title}</div>
                <div class="entry-meta">
                  {platformChip(e.platform) && <span class="chip plat">{platformChip(e.platform)}</span>}
                  {e.pillar && <span class="chip cat">{e.pillar.split('(')[0].trim()}</span>}
                  {e.critic != null && <span class="chip score">{e.critic.toFixed(1)}</span>}
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                  {e.hasVisual && <span class="chip vis">Visual</span>}
                </div>
                <div class="entry-expand">
                  {e.body
                    ? bodySections(e.body).map((s) => (
                        <div class="body-sec">
                          {s.label && <div class="body-sec-label">{s.label}</div>}
                          <pre>{s.text}</pre>
                        </div>
                      ))
                    : <pre>(no content yet)</pre>}
                  <textarea class="entry-edit-area" data-num={e.num}>{e.body || ''}</textarea>
                  <div class="entry-actions">
                    <button class="btn edit-btn" data-num={e.num}>Edit</button>
                    <button class="btn save save-btn" data-num={e.num} style="display:none">Save</button>
                    <button class="btn cancel-btn" data-num={e.num} style="display:none">Cancel</button>
                    {e.body && <button class="btn copy-btn" data-copy={e.body}>Copy post</button>}
                    {e.status === 'READY TO POST' && (
                      <button class="btn approve-btn" data-num={e.num}>Schedule → Blotato</button>
                    )}
                  </div>
                </div>
              </div>
              <div class="entry-status">
                {STATUSES.map((s) => (
                  <button class={`sbtn ${e.status === s.key ? 'cur' : ''}`}
                          style={e.status === s.key ? `--sc: ${s.color}` : undefined}
                          data-num={e.num} data-status={s.key}>{s.short}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ════ PAGE: Inventory ════ -->
      <div class="page" id="p-inventory">
        <div class="page-head">
          <h2>Inventory</h2>
          <span class="breadcrumb">Content OS / <span>Channels, offers &amp; tools</span></span>
        </div>

        <div class="panel">
          <h3>Channels</h3>
          <table class="data-table">
            <thead><tr><th></th><th>Channel</th><th>Role</th><th>Handle</th><th>Notes</th></tr></thead>
            <tbody>
              {d.channels.map((ch) => (
                <tr>
                  <td><span class="ch-dot" style={`background:${ch.connected ? 'var(--green)' : 'var(--red)'}`}></span></td>
                  <td><b>{ch.name}</b></td>
                  <td>{ch.role}</td>
                  <td style="font-size:13px;color:var(--mut)">{ch.handle}</td>
                  <td style="font-size:13px;color:var(--mut)">{ch.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid2">
          <div class="panel">
            <h3>Offers</h3>
            <div style="display:flex;flex-direction:column;gap:10px">
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">1.</span> Paid community / membership <span class="chip" style="background:var(--accent)">Core</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">2.</span> Digital products / courses</div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">3.</span> Corporate speaking / workshops <span class="chip" style="background:var(--accent)">High-ticket</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">4.</span> Packaged OS to sell <span class="chip" style="background:var(--electric)">Roadmap</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">5.</span> Affiliate / sponsorships <span class="chip" style="background:var(--mut)">Opportunistic</span></div>
            </div>
          </div>
          <div class="panel">
            <h3>Data Sources</h3>
            <div style="display:flex;flex-direction:column;gap:10px;font-size:14px">
              <div>📄 <b>research-notes.md</b> — {d.researchCount} research entries</div>
              <div>📁 <b>reports/</b> — {d.reports.length} reports</div>
              <div>📋 <b>inspiration-library/creators.csv</b> — 21 tracked creators</div>
              <div>🌐 Web research (Tavily / WebSearch) at runtime</div>
            </div>
          </div>
        </div>

        <div class="panel">
          <h3>Live-wiring gaps</h3>
          <table class="data-table">
            <thead><tr><th>Gap</th><th>What's needed</th><th>Unblocks</th></tr></thead>
            <tbody>
              <tr><td>Meta Graph API</td><td>META_ACCESS_TOKEN + IG_BUSINESS_ID + FB_PAGE_ID</td><td style="color:var(--blue)">performance-tracker (M06)</td></tr>
              <tr><td>Blotato media egress</td><td>Allowlist *.blotato.io in env network egress</td><td style="color:var(--blue)">Upload HeyGen MP4, ai-avatar-broll</td></tr>
              <tr><td>Higgsfield MCP</td><td>Add Higgsfield MCP server + record avatar/voice IDs</td><td style="color:var(--blue)">heygen (talking-head of her — primary)</td></tr>
              <tr><td>HeyGen (fallback)</td><td>HEYGEN_API_KEY + allowlist api.heygen.com</td><td style="color:var(--blue)">heygen (talking-head fallback)</td></tr>
              <tr><td>Opus Clip</td><td>OPUS_CLIP_API_KEY + allowlist api.opus.pro</td><td style="color:var(--blue)">reels-factory</td></tr>
              <tr><td>Signal sources</td><td>Confirm Apify/Tavily MCP usable from signal-harvester</td><td style="color:var(--blue)">signal-harvester live</td></tr>
              <tr><td>TikTok</td><td>Connect TikTok account to Blotato</td><td style="color:var(--blue)">TikTok publishing</td></tr>
              <tr><td>Always-on host</td><td>Small VPS or scheduled web sessions for crons + DM webhook</td><td style="color:var(--blue)">M05 + every-N-min crons</td></tr>
            </tbody>
          </table>
        </div>

        <div class="panel">
          <h3>Integration backlog (connected, not yet wired)</h3>
          <table class="data-table">
            <thead><tr><th>Tool</th><th>Potential role</th><th>Step</th></tr></thead>
            <tbody>
              <tr><td><b>Notion</b></td><td>External content calendar / board mirrored from the vault</td><td style="color:var(--accent-deep)">1</td></tr>
              <tr><td><b>Google Drive</b></td><td>Asset storage for generated visuals</td><td style="color:var(--accent-deep)">6</td></tr>
              <tr><td><b>Granola</b></td><td>Meeting notes → content raw material</td><td style="color:var(--accent-deep)">1</td></tr>
              <tr><td><b>GitHub</b></td><td>Hosting / sync / automation triggers</td><td style="color:var(--accent-deep)">6</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ════ PAGE: Architecture ════ -->
      <div class="page" id="p-architecture">
        <div class="page-head">
          <h2>Architecture</h2>
          <span class="breadcrumb">Content OS / <span>System map (Romain 8-step)</span></span>
        </div>

