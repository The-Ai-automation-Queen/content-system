---
import { getDashboard } from '../lib/data.js';

const tenant = Astro.url.searchParams.get('tenant') || 'root';
const d = getDashboard(tenant);
const MSTATUS = {
  live: { c: '#3fb950', t: 'live' },
  partial: { c: '#d4a72c', t: 'partial' },
  'needs-key': { c: '#f85149', t: 'needs key' },
  'needs-setup': { c: '#f85149', t: 'needs setup' },
};

const REPORT_META = {
  'research-digest': { label: 'Research sweep', icon: '🔎' },
  'competitor-watch': { label: 'Competitor watch', icon: '🛰️' },
  'vault-audit': { label: 'Vault audit', icon: '🩺' },
  'distribution': { label: 'Distribution', icon: '📤' },
};

const FLAG_LABEL = {
  PERSONALIZE: 'Personalize',
  VERIFY: 'Verify a fact',
  PREP: 'Prep a resource',
  'NEEDS HER FACE': 'Needs her face',
  'NEEDS VISUAL': 'Needs visual',
};

const maxPillar = Math.max(1, ...d.pillars.map((p) => p.n));
const platformChip = (p) => (p || '').split('(')[0].trim();
const STATUSES = [
  { key: 'DRAFT', short: 'Draft' },
  { key: 'READY TO POST', short: 'Ready' },
  { key: 'SCHEDULED', short: 'Sched' },
  { key: 'POSTED', short: 'Posted' },
];

// Performance: top 5 posts sorted by total engagement
const perfLatest = d.performance.latest;
const perfTopPosts = perfLatest
  ? [...perfLatest.topPosts]
      .sort((a, b) => (b.likes + b.comments + b.views) - (a.likes + a.comments + a.views))
      .slice(0, 5)
  : [];
const perfProfiles = perfLatest ? Object.entries(perfLatest.profiles) : [];

// Hook scorecard: max count for bar width
const maxHook = Math.max(1, ...d.hookScorecard.map((h) => h.count));

// Platform display names for profile chips
const PLAT_LABELS: Record<string, string> = {
  instagram: 'IG', ig: 'IG', youtube: 'YT', yt: 'YT',
  tiktok: 'TikTok', linkedin: 'LinkedIn', facebook: 'FB', fb: 'FB',
  x: 'X', twitter: 'X',
};
const platLabel = (k: string) => PLAT_LABELS[k] || k;
const fmtNum = (n: number) => n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K' : String(n);
const truncate = (s: string, len = 40) => s.length > len ? s.slice(0, len) + '...' : s;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mission Control · The AI Automation Queen</title>
    <style>
      :root {
        --bg: #0d1117; --panel: #161b22; --panel2: #1c2230; --line: #2a3140;
        --ink: #e6edf3; --mut: #9aa7b6; --gold: #d4a72c; --gold2: #f2c94c;
        --green: #3fb950; --blue: #58a6ff; --purple: #a371f7; --red: #f85149;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg);
        color: var(--ink); font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        padding: 0;
      }
      a { color: var(--blue); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 4px; }
      h1 { font-size: clamp(22px, 3vw, 30px); margin: 0; letter-spacing: -0.4px; }
      .crown { color: var(--gold2); }
      .sub { color: var(--mut); margin: 2px 0 26px; }
      .sub b { color: var(--ink); font-weight: 600; }

      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 30px; }
      .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
      .kpi .n { font-size: 30px; font-weight: 700; line-height: 1; }
      .kpi .l { color: var(--mut); font-size: 12.5px; margin-top: 7px; text-transform: uppercase; letter-spacing: 0.5px; }
      .kpi.gold .n { color: var(--gold2); } .kpi.green .n { color: var(--green); }
      .kpi.blue .n { color: var(--blue); } .kpi.purple .n { color: var(--purple); }
      .kpi.red .n { color: var(--red); }

      h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 1px; color: var(--mut); margin: 34px 0 14px; }

      .board { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .col { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }
      .col h3 { margin: 0 0 12px; font-size: 13px; display: flex; align-items: center; gap: 8px; }
      .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
      .col .count { margin-left: auto; color: var(--mut); font-weight: 600; }
      .card { background: var(--panel2); border: 1px solid var(--line); border-radius: 11px; padding: 11px 12px; margin-bottom: 10px; }
      .card:last-child { margin-bottom: 0; }
      .card .t { font-weight: 600; font-size: 14px; }
      .card .meta { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 9px; }
      .chip { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: #20283a; color: var(--mut); border: 1px solid var(--line); white-space: nowrap; }
      .chip.entry { color: var(--gold2); border-color: #4a3d18; background: #221d10; }
      .chip.score { color: var(--green); border-color: #1d3a23; background: #11261a; }
      .chip.score.low { color: var(--gold2); }
      .chip.flag { color: var(--red); border-color: #4a1f1d; background: #2a1413; }
      .chip.vis { color: var(--purple); border-color: #33244a; background: #1c1430; }
      .empty { color: var(--mut); font-size: 13px; font-style: italic; padding: 6px 2px; }

      .expand-btn { font: inherit; font-size: 11px; padding: 3px 9px; border-radius: 7px; background: #18202e; color: var(--blue); border: 1px solid var(--line); cursor: pointer; margin-top: 8px; }
      .expand-btn:hover { border-color: var(--blue); }
      .body-preview { display: none; margin-top: 10px; padding: 12px 14px; background: #0d1117; border: 1px solid var(--line); border-radius: 9px; font-size: 13px; line-height: 1.65; color: var(--ink); white-space: pre-wrap; word-break: break-word; max-height: 480px; overflow-y: auto; }
      .body-preview.open { display: block; }
      .body-preview strong { color: var(--gold2); }
      .body-preview code { background: #18202e; padding: 1px 5px; border-radius: 4px; font-size: 12px; color: var(--blue); }

      .grid2 { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 22px; align-items: start; }
      @media (max-width: 820px) { .grid2 { grid-template-columns: 1fr; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px; }

      .pillar { margin-bottom: 12px; }
      .pillar .row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 5px; }
      .bar { height: 8px; background: #20283a; border-radius: 999px; overflow: hidden; }
      .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); }

      .runs { list-style: none; padding: 0; margin: 0; }
      .runs li { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: 13.5px; }
      .runs li:last-child { border-bottom: 0; }
      .runs .date { margin-left: auto; color: var(--mut); font-variant-numeric: tabular-nums; }

      .attn { display: flex; flex-direction: column; gap: 10px; }
      .attn .item { display: flex; gap: 10px; align-items: center; background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 9px; padding: 9px 11px; font-size: 13.5px; }
      .attn .item .t { font-weight: 600; }

      .links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
      .btn { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 14px; color: var(--ink); font-weight: 600; font-size: 13.5px; }
      .btn:hover { border-color: var(--gold); text-decoration: none; }
      .actions { display: flex; gap: 4px; margin-top: 9px; flex-wrap: wrap; }
      .sbtn { font: inherit; font-size: 10.5px; padding: 3px 8px; border-radius: 7px; background: #1a2030; color: var(--mut); border: 1px solid var(--line); cursor: pointer; }
      .sbtn:hover { border-color: var(--gold); color: var(--ink); }
      .sbtn.cur { background: #221d10; color: var(--gold2); border-color: #4a3d18; cursor: default; }
      .sbtn:disabled { opacity: 0.5; cursor: wait; }
      .tenants { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }
      .tchip { font-size: 12px; padding: 4px 11px; border-radius: 999px; background: var(--panel); color: var(--mut); border: 1px solid var(--line); }
      .tchip.cur { color: var(--gold2); border-color: #4a3d18; background: #221d10; }
      .tchip:hover { text-decoration: none; border-color: var(--gold); }
      .cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
      @media (max-width: 760px) { .cal { grid-template-columns: repeat(2, 1fr); } }
      .cell { background: var(--panel); border: 1px solid var(--line); border-radius: 11px; padding: 9px 9px 7px; min-height: 78px; }
      .cell.today { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold) inset; }
      .cell .d { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; color: var(--mut); margin-bottom: 7px; }
      .cell .d .dom { font-weight: 700; font-size: 14px; color: var(--ink); }
      .cell.today .d .dom { color: var(--gold2); }
      .cev { display: block; font-size: 10.5px; padding: 3px 6px; border-radius: 6px; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cev.sched { background: #221d10; color: var(--gold2); border: 1px solid #4a3d18; }
      .cev.posted { background: #1c1430; color: var(--purple); border: 1px solid #33244a; }
      .callegend { display: flex; gap: 16px; color: var(--mut); font-size: 12px; margin: 0 2px 12px; }
      .callegend i { font-style: normal; } .callegend .sw { display: inline-block; width: 9px; height: 9px; border-radius: 3px; margin-right: 5px; vertical-align: middle; }
      .machines { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
      .machine { background: var(--panel); border: 1px solid var(--line); border-radius: 13px; padding: 14px; }
      .mhead { display: flex; align-items: center; gap: 8px; }
      .mdot { width: 9px; height: 9px; border-radius: 50%; }
      .mname { font-weight: 600; font-size: 14px; }
      .mid { margin-left: auto; font-size: 10.5px; color: var(--mut); font-family: ui-monospace, monospace; }
      .mnote { color: var(--mut); font-size: 12.5px; margin: 9px 0 11px; line-height: 1.45; min-height: 34px; }
      .mfoot { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; }
      .mfoot code { color: var(--blue); background: #18202e; padding: 2px 7px; border-radius: 6px; }
      .mstatus { font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-size: 10.5px; }
      /* Performance, Competitor Intel, Hook Scorecard panels */
      .perf-profiles { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
      .perf-chip { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; text-align: center; min-width: 100px; }
      .perf-chip .pn { font-size: 22px; font-weight: 700; color: var(--gold2); line-height: 1; }
      .perf-chip .pl { font-size: 11px; color: var(--mut); margin-top: 5px; text-transform: uppercase; letter-spacing: 0.4px; }
      .perf-table { width: 100%; border-collapse: collapse; font-size: 13px; }
      .perf-table th { text-align: left; color: var(--mut); font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
      .perf-table td { padding: 8px; border-bottom: 1px solid var(--line); }
      .perf-table tr:last-child td { border-bottom: 0; }
      .perf-table .num { text-align: right; font-variant-numeric: tabular-nums; color: var(--mut); }

      .intel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
      @media (max-width: 820px) { .intel-grid { grid-template-columns: 1fr; } }
      .creator-card { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; }
      .creator-card .cn { font-weight: 700; font-size: 13.5px; color: var(--ink); }
      .creator-card .ci { color: var(--mut); font-size: 12.5px; margin-top: 4px; line-height: 1.45; }
      .intel-list { list-style: none; padding: 0; margin: 0; }
      .intel-list li { padding: 7px 0; border-bottom: 1px dashed var(--line); font-size: 13px; line-height: 1.5; }
      .intel-list li:last-child { border-bottom: 0; }
      .intel-list.numbered { counter-reset: il; }
      .intel-list.numbered li::before { counter-increment: il; content: counter(il) ". "; color: var(--gold2); font-weight: 700; }
      .gap-item { background: linear-gradient(90deg, rgba(63,185,80,0.08) 0%, transparent 100%); border-left: 3px solid var(--green); border-radius: 0 8px 8px 0; padding: 8px 12px; margin-bottom: 8px; font-size: 13px; line-height: 1.5; }
      .gap-item:last-child { margin-bottom: 0; }

      .hook-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
      .hook-row:last-child { margin-bottom: 0; }
      .hook-label { min-width: 200px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .hook-bar-wrap { flex: 1; height: 10px; background: #20283a; border-radius: 999px; overflow: hidden; }
      .hook-bar-wrap > span { display: block; height: 100%; background: linear-gradient(90deg, var(--purple), var(--blue)); border-radius: 999px; }
      .hook-count { min-width: 28px; text-align: right; font-size: 13px; font-weight: 700; color: var(--blue); font-variant-numeric: tabular-nums; }

      .new-panels { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 22px; }
      @media (max-width: 1100px) { .new-panels { grid-template-columns: 1fr; } }

      footer { color: var(--mut); font-size: 12px; margin-top: 40px; }

      /* Sidebar */
      .layout { display: flex; min-height: 100vh; }
      .sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; width: 180px;
        background: var(--panel); border-right: 1px solid var(--line);
        display: flex; flex-direction: column; padding: 22px 0 16px; z-index: 100;
        overflow-y: auto;
      }
      .sidebar .brand { padding: 0 18px 18px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
      .sidebar .brand-name { font-weight: 800; font-size: 14px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--ink); }
      .sidebar .brand-sub { font-size: 10.5px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.4px; margin-top: 3px; }
      .sidebar nav { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 0 8px; }
      .sidebar nav a {
        display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 9px;
        font-size: 13px; font-weight: 500; color: var(--mut); text-decoration: none; transition: background 0.15s;
      }
      .sidebar nav a:hover { background: var(--panel2); color: var(--ink); text-decoration: none; }
      .sidebar nav a.active { background: #1a2744; color: var(--blue); font-weight: 600; }
      .sidebar nav a .icon { width: 18px; text-align: center; font-size: 14px; flex-shrink: 0; }
      .sidebar .sidebar-spacer { flex: 1; }
      .sidebar .sidebar-bottom { padding: 12px 18px; border-top: 1px solid var(--line); margin-top: 8px; }
      .sidebar .sidebar-bottom .tenant-info { font-size: 10.5px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.3px; }
      .main-content { margin-left: 180px; flex: 1; padding: 28px clamp(16px, 4vw, 48px) 64px; }
      @media (max-width: 768px) {
        .sidebar { display: none; }
        .main-content { margin-left: 0; }
      }
    </style>
  </head>
  <body>
    <div class="layout">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-name">Content OS</div>
        <div class="brand-sub">The AI Automation Queen</div>
      </div>
      <nav>
        <a href="#top" class="active"><span class="icon">📊</span> Dashboard</a>
        <a href="#pipeline"><span class="icon">🧠</span> Second Brain</a>
        <a href="#"><span class="icon">📦</span> Inventory</a>
        <a href="#"><span class="icon">🏗️</span> Architecture</a>
        <a href="#engine"><span class="icon">⚙️</span> Machines</a>
        <a href="#calendar"><span class="icon">📅</span> Calendar</a>
        <a href="#"><span class="icon">🔁</span> Crons</a>
        <a href="#"><span class="icon">🤖</span> Agents</a>
        <a href="#"><span class="icon">💰</span> Costs</a>
        <a href="#"><span class="icon">💻</span> CLI</a>
        <a href="#"><span class="icon">🔔</span> Alerts</a>
        <a href="#"><span class="icon">🔧</span> Settings</a>
      </nav>
      <div class="sidebar-spacer"></div>
      <div class="sidebar-bottom">
        <div class="tenant-info">Tenant: {d.tenant === 'root' ? 'Fatiha' : d.tenant} (root)</div>
        <div class="tenant-info">{new Date(d.generatedAt).toLocaleString()}</div>
      </div>
    </aside>
    <div class="main-content">
    <header>
      <h1><span class="crown">👑</span> Mission Control</h1>
      <span class="sub" style="margin:0">The AI Automation Queen · content Business OS</span>
      <span class="tenants">
        {d.tenants.map((t) => (
          <a class={`tchip ${ (tenant === t || (tenant === 'root' && t === 'root')) ? 'cur' : ''}`} href={t === 'root' ? '/' : `/?tenant=${t}`}>{t === 'root' ? 'Fatiha' : t}</a>
        ))}
      </span>
    </header>
    <p class="sub">
      Live view of the <b>second brain</b> — the markdown files <i>are</i> the database.
      The agent loop (research → draft → visual → queue) writes here; <b>click a status on any
      card</b> to move it through the pipeline yourself.
    </p>

    <div class="kpis">
      <div class="kpi"><div class="n">{d.kpis.total}</div><div class="l">Total pieces</div></div>
      <div class="kpi green"><div class="n">{d.kpis.ready}</div><div class="l">Ready to post</div></div>
      <div class="kpi gold"><div class="n">{d.kpis.scheduled}</div><div class="l">Scheduled</div></div>
      <div class="kpi purple"><div class="n">{d.kpis.posted}</div><div class="l">Posted</div></div>
      <div class="kpi"><div class="n">{d.kpis.draft}</div><div class="l">Drafts</div></div>
      <div class="kpi red"><div class="n">{d.kpis.flagged}</div><div class="l">Need your input</div></div>
      <div class="kpi blue"><div class="n">{d.kpis.withVisual}</div><div class="l">With visual</div></div>
    </div>

    <h2 id="engine">The Engine — {d.machines.length} machines</h2>
    <div class="machines">
      {d.machines.map((m) => {
        const s = MSTATUS[m.status] || MSTATUS.partial;
        return (
          <div class="machine">
            <div class="mhead">
              <span class="mdot" style={`background:${s.c}`}></span>
              <span class="mname">{m.name}</span>
              <span class="mid">{m.id}</span>
            </div>
            <div class="mnote">{m.note}</div>
            <div class="mfoot"><code>{m.skill}</code><span class="mstatus" style={`color:${s.c}`}>{s.t}</span></div>
          </div>
        );
      })}
    </div>

    <h2 id="pipeline">Pipeline</h2>
    <div class="board">
      {d.columns.map((col) => (
        <div class="col">
          <h3><span class="dot" style={`background:${col.color}`}></span>{col.label}<span class="count">{col.items.length}</span></h3>
          {col.items.length === 0 && <div class="empty">Nothing here.</div>}
          {col.items.map((e) => (
            <div class="card">
              <div class="t">{e.title}</div>
              <div class="meta">
                <span class="chip entry">#{e.num}</span>
                {platformChip(e.platform) && <span class="chip">{platformChip(e.platform)}</span>}
                {e.pillar && <span class="chip">{e.pillar.split('(')[0].trim()}</span>}
                {e.critic != null && <span class={`chip score ${e.critic < 8 ? 'low' : ''}`}>{e.critic.toFixed(1)}</span>}
                {e.hasVisual && (e.visualUrl ? <a class="chip vis" href={e.visualUrl} target="_blank">🎬 visual</a> : <span class="chip vis">🎬 visual</span>)}
                {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
              </div>
              {e.body && (
                <button class="expand-btn" data-target={`body-${e.num}`}>Read full content ▾</button>
              )}
              {e.body && (
                <div class="body-preview" id={`body-${e.num}`} set:html={e.body
                  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                  .replace(/\*\*\[([^\]]+)\]\*\*/g, '<strong>[$1]</strong>')
                  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                  .replace(/`([^`]+)`/g, '<code>$1</code>')
                } />
              )}
              <div class="actions">
                {STATUSES.map((s) => (
                  <button class={`sbtn ${e.status === s.key ? 'cur' : ''}`} data-num={e.num} data-status={s.key}>{s.short}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <h2 id="calendar">Editorial calendar · next 14 days</h2>
    <div class="callegend">
      <span><i class="sw" style="background:var(--gold2)"></i>Scheduled</span>
      <span><i class="sw" style="background:var(--purple)"></i>Posted</span>
    </div>
    <div class="cal">
      {d.calendar.map((c) => (
        <div class={`cell ${c.isToday ? 'today' : ''}`}>
          <div class="d"><span>{c.dow}</span><span class="dom">{c.dom}</span></div>
          {c.items.map((e) => (
            <span class={`cev ${e.status === 'POSTED' ? 'posted' : 'sched'}`} title={`#${e.num} ${e.title} · ${platformChip(e.platform)}`}>#{e.num} {e.title}</span>
          ))}
        </div>
      ))}
    </div>

    <div class="new-panels">
      <!-- Panel 1: Performance -->
      <div>
        <h2>Performance</h2>
        <div class="panel">
          {perfLatest ? (
            <>
              <div style="color:var(--mut); font-size:12px; margin-bottom:12px;">Snapshot from {perfLatest.date}</div>
              {perfProfiles.length > 0 && (
                <div class="perf-profiles">
                  {perfProfiles.map(([key, stats]) => {
                    const mainNum = (stats as any).followers ?? (stats as any).subs ?? (stats as any).views ?? 0;
                    const mainLabel = (stats as any).followers != null ? 'followers'
                      : (stats as any).subs != null ? 'subs' : 'views';
                    return (
                      <div class="perf-chip">
                        <div class="pn">{fmtNum(mainNum)}</div>
                        <div class="pl">{platLabel(key)} {mainLabel}</div>
                      </div>
                    );
                  })}
                </div>
              )}
              {perfTopPosts.length > 0 ? (
                <table class="perf-table">
                  <thead><tr><th>Post</th><th>Platform</th><th class="num">Likes</th><th class="num">Comments</th><th class="num">Views</th></tr></thead>
                  <tbody>
                    {perfTopPosts.map((p) => (
                      <tr>
                        <td>{truncate(p.title)}</td>
                        <td><span class="chip">{platformChip(p.platform)}</span></td>
                        <td class="num">{fmtNum(p.likes)}</td>
                        <td class="num">{fmtNum(p.comments)}</td>
                        <td class="num">{fmtNum(p.views)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <div class="empty">No top posts tracked yet.</div>
              )}
            </>
          ) : (
            <div class="empty">No data yet — run <code>/performance-tracker</code> to start tracking.</div>
          )}
        </div>
      </div>

      <!-- Panel 2: Competitor Intel -->
      <div>
        <h2>Competitor Intel</h2>
        <div class="panel">
          {d.competitor.date ? (
            <>
              <div style="color:var(--mut); font-size:12px; margin-bottom:12px;">Latest scan: {d.competitor.date}</div>
              {d.competitor.creators.length > 0 && (
                <>
                  <div style="font-size:12px; color:var(--mut); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:8px;">Creators</div>
                  <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:16px;">
                    {d.competitor.creators.slice(0, 5).map((c) => (
                      <div class="creator-card">
                        <div class="cn">{c.name}</div>
                        <div class="ci">{truncate(c.insight, 120)}</div>
                      </div>
                    ))}
                  </div>
                </>
              )}
              {d.competitor.hooks.length > 0 && (
                <>
                  <div style="font-size:12px; color:var(--mut); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:8px;">Top hooks to adapt</div>
                  <ul class="intel-list numbered">
                    {d.competitor.hooks.map((h) => <li>{h}</li>)}
                  </ul>
                </>
              )}
              {d.competitor.gaps.length > 0 && (
                <>
                  <div style="font-size:12px; color:var(--mut); text-transform:uppercase; letter-spacing:0.4px; margin:16px 0 8px;">Gaps you could own</div>
                  <div>
                    {d.competitor.gaps.map((g) => <div class="gap-item">{g}</div>)}
                  </div>
                </>
              )}
            </>
          ) : (
            <div class="empty">No competitor watch report found yet.</div>
          )}
        </div>
      </div>

      <!-- Panel 3: Hook Scorecard -->
      <div>
        <h2>Hook Scorecard</h2>
        <div class="panel">
          {d.hookScorecard.length > 0 ? (
            <>
              <div style="color:var(--mut); font-size:12px; margin-bottom:14px;">Pattern usage across {d.entries.length} vault entries</div>
              {d.hookScorecard.map((h) => (
                <div class="hook-row">
                  <span class="hook-label" title={h.pattern}>{h.pattern}</span>
                  <div class="hook-bar-wrap"><span style={`width:${(h.count / maxHook) * 100}%`}></span></div>
                  <span class="hook-count">{h.count}</span>
                </div>
              ))}
            </>
          ) : (
            <div class="empty">No hook patterns detected in vault entries yet.</div>
          )}
        </div>
      </div>
    </div>

    <div class="grid2">
      <div>
        <h2>Needs your input</h2>
        <div class="panel">
          {d.flagged.length === 0 && <div class="empty">Nothing blocked — everything's clear to move. 🎉</div>}
          <div class="attn">
            {d.flagged.map((e) => (
              <div class="item">
                <span class="chip entry">#{e.num}</span>
                <span class="t">{e.title}</span>
                <span style="margin-left:auto; display:flex; gap:6px; flex-wrap:wrap">
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                </span>
              </div>
            ))}
          </div>
        </div>

        <h2>Content pillars</h2>
        <div class="panel">
          {d.pillars.map((p) => (
            <div class="pillar">
              <div class="row"><span>{p.name}</span><span>{p.n}</span></div>
              <div class="bar"><span style={`width:${(p.n / maxPillar) * 100}%`}></span></div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h2>Recent runs (audit trail)</h2>
        <div class="panel">
          <ul class="runs">
            {d.reports.slice(0, 12).map((r) => {
              const meta = REPORT_META[r.type] || { label: r.type, icon: '📄' };
              return (
                <li><span>{meta.icon}</span><span>{meta.label}</span><span class="date">{r.date}</span></li>
              );
            })}
            {d.reports.length === 0 && <li class="empty">No reports yet.</li>}
          </ul>
        </div>

        <h2>Control room</h2>
        <div class="panel">
          <div style="color:var(--mut); font-size:13.5px">
            {d.researchCount} research entries · {d.kpis.withVisual} with a visual ·
            {d.leads.active}/{d.leads.total} lead magnets active · tenant: <b>{d.tenant}</b>
          </div>
          <div class="links">
            <a class="btn" href="https://my.blotato.com" target="_blank">📤 Blotato queue</a>
            <a class="btn" href="https://github.com/the-ai-automation-queen/content-system" target="_blank">🧠 GitHub repo</a>
          </div>
        </div>
      </div>
    </div>

    <footer>
      Generated {new Date(d.generatedAt).toLocaleString()} · reads <code>content-vault.md</code>,
      <code>reports/</code>, <code>research-notes.md</code> · refresh the page after an agent run.
    </footer>
    <script type="module">
      for (const b of document.querySelectorAll('.sbtn')) {
        b.addEventListener('click', async () => {
          if (b.classList.contains('cur')) return;
          b.disabled = true;
          try {
            const r = await fetch('/api/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }),
            });
            const j = await r.json();
            if (j.ok) location.reload();
            else { alert('Update failed: ' + (j.error || 'unknown')); b.disabled = false; }
          } catch (err) { alert('Update failed: ' + err); b.disabled = false; }
        });
      }
      for (const b of document.querySelectorAll('.expand-btn')) {
        b.addEventListener('click', () => {
          const el = document.getElementById(b.dataset.target);
          if (!el) return;
          const open = el.classList.toggle('open');
          b.textContent = open ? 'Hide content ▴' : 'Read full content ▾';
        });
      }
    </script>
    </div><!-- .main-content -->
    </div><!-- .layout -->
  </body>
</html>
