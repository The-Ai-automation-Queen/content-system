---
import { getDashboard } from '../lib/data.js';

const tenant = Astro.url.searchParams.get('tenant') || 'root';
const d = getDashboard(tenant);

const MSTATUS = {
  live: { c: '#1E8E5A', t: 'LIVE' },
  partial: { c: '#B26A00', t: 'PARTIAL' },
  'needs-key': { c: '#E63955', t: 'NEEDS KEY' },
  'needs-setup': { c: '#E63955', t: 'NEEDS SETUP' },
};

const FLAG_LABEL = {
  PERSONALIZE: 'Personalize',
  VERIFY: 'Verify a fact',
  PREP: 'Prep a resource',
  'NEEDS HER FACE': 'Needs her face',
  'NEEDS VISUAL': 'Needs visual',
};

const STATUSES = [
  { key: 'DRAFT', short: 'Draft', color: '#5C5A57' },
  { key: 'READY TO POST', short: 'Ready', color: '#1E8E5A' },
  { key: 'SCHEDULED', short: 'Scheduled', color: '#B26A00' },
  { key: 'POSTED', short: 'Posted', color: '#6B35C2' },
];

const platformChip = (p) => (p || '').split('(')[0].trim();
const maxPillar = Math.max(1, ...d.pillars.map((p) => p.n));

const CRONS = [
  { machine: 'M01', name: 'Signal Harvester', schedule: 'Every day 02:00', retry: 'Retry 04:00', check: 'Verify 02:30' },
  { machine: 'M01', name: 'Content Engine', schedule: 'Weekly Mon 06:00', retry: 'Retry 08:00', check: 'Part of weekly-ops' },
  { machine: 'M05', name: 'DM Responder', schedule: 'Every 5 min', retry: 'Auto-restart', check: 'Continuous' },
];

const REPORT_META = {
  'research-digest': { label: 'Research sweep', icon: '🔎' },
  'competitor-watch': { label: 'Competitor watch', icon: '🛰️' },
  'vault-audit': { label: 'Vault audit', icon: '🩺' },
  'distribution': { label: 'Distribution', icon: '📤' },
  'architecture-analysis': { label: 'Architecture analysis', icon: '🏗️' },
};

const COSTS = [
  { tool: 'Claude Code', plan: 'Max ($200/mo)', type: 'Core', note: 'Powers the entire system' },
  { tool: 'Blotato', plan: 'Pro ($29/mo)', type: 'Publishing', note: 'Multi-platform queue + AI visuals' },
  { tool: 'Canva', plan: 'Pro ($13/mo)', type: 'Visual', note: 'Carousels, thumbnails' },
  { tool: 'SupaData', plan: 'Starter ($9/mo)', type: 'Research', note: 'Video transcripts' },
  { tool: 'HeyGen', plan: 'Creator ($29/mo)', type: 'Video', note: 'Talking-head avatar (optional)' },
  { tool: 'Apify', plan: 'Free tier', type: 'Research', note: 'Social scraping' },
  { tool: 'Tavily', plan: 'Free tier', type: 'Research', note: 'Web search' },
  { tool: 'GoHighLevel', plan: 'Starter ($97/mo)', type: 'Leads', note: 'DM responder + CRM' },
  { tool: 'VPS', plan: '~$10/mo', type: 'Hosting', note: 'Crons + webhook host' },
];

const totalCost = COSTS.reduce((s, c) => {
  const m = (c.plan || '').match(/\$(\d+)/);
  return s + (m ? parseInt(m[1]) : 0);
}, 0);

// Icon + accent per skill (Romain-style colored icon tiles)
const SKILL_ICON = {
  'signal-harvester': '📡', 'content-engine': '✍️', 'visual-engine': '🎨',
  'heygen': '🎬', 'reels-factory': '🎞️', 'distribution': '📤', 'dm-responder': '💬',
  'weekly-ops': '🔄', 'vault-audit': '🩺', 'competitor-watch': '🔭', 'supadata-transcript': '📝',
};
const GROUP_COLOR = {
  'REELS (INSTAGRAM / TIKTOK)': '#E63955',
  'LINKEDIN': '#2C4BE0',
  'YOUTUBE': '#E63955',
  'X (TWITTER)': '#1A1A1A',
  'CROSS-PLATFORM': '#6B35C2',
  'SYSTEM': '#1B2EA0',
};

// Machine groups + filter tabs
const machineGroups = [...new Set(d.machines.map((m) => m.group))];
const liveCount = d.machines.filter((m) => m.status === 'live').length;
const buildCount = d.machines.filter((m) => m.status !== 'live').length;

const dataPayload = JSON.stringify({ entries: d.entries, calendar: d.calendar, machines: d.machines });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Content OS · The AI Automation Queen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,700&family=Source+Serif+4:ital,wght@0,400;0,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style is:global>
      /* ════ Shift & Lead brand system — light editorial ════ */
      :root {
        --canvas: #F8F7F5; --cream: #F4F0FA; --accent-tint: #EEE5FA;
        --accent: #6B35C2; --accent-deep: #4A1F8F; --electric: #2C4BE0; --navy: #1B2EA0;
        /* mapped to existing class names so everything inherits the brand */
        --bg: #F8F7F5; --sidebar: #FFFFFF; --panel: #FFFFFF; --panel2: #F4F0FA;
        --line: #D8D6D2; --ink: #1A1A1A; --mut: #5C5A57;
        --gold: #6B35C2; --gold2: #4A1F8F;
        --green: #1E8E5A; --blue: #2C4BE0; --purple: #6B35C2; --red: #E63955; --cyan: #1B2EA0;
        --amber: #B26A00; --term: #1A1A1A;
        --mono: 'Space Mono', ui-monospace, monospace;
        --serif: 'Playfair Display', Georgia, serif;
        --ui: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      /* ════ Night theme — comfortable dark for after-dark viewing ════ */
      [data-theme="dark"] {
        --canvas: #131019; --cream: #1C1726; --accent-tint: #271D3D;
        --accent: #A371F7; --accent-deep: #C8A6FF; --electric: #6E8BFF; --navy: #93A4FF;
        --bg: #131019; --sidebar: #181321; --panel: #1B1626; --panel2: #241D33;
        --line: #322A42; --ink: #ECE6F3; --mut: #A99FC0;
        --gold: #A371F7; --gold2: #C8A6FF;
        --green: #5BD68A; --blue: #6E8BFF; --purple: #A371F7; --red: #FF6B7E; --cyan: #93A4FF;
        --amber: #E0A040; --term: #0E0B14;
        color-scheme: dark;
      }
      [data-theme="dark"] .m-icon { box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14); }
      [data-theme="dark"] .chip { color: #15111E; }

      /* Theme toggle button */
      .theme-toggle { display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 12px; padding: 8px 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 2px; color: var(--ink); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: all 0.12s; }
      .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
      .theme-toggle .tt-ico { font-size: 13px; }
      * { box-sizing: border-box; margin: 0; }
      body { background: var(--bg); color: var(--ink); font: 15px/1.6 var(--ui); display: flex; height: 100vh; overflow: hidden; -webkit-font-smoothing: antialiased; }
      a { color: var(--accent); text-decoration: none; }

      /* ── Sidebar ── */
      .sidebar { width: 230px; min-width: 230px; background: var(--sidebar); border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow-y: auto; }
      .sidebar .logo { padding: 22px 20px 18px; border-bottom: 1px solid var(--line); }
      .sidebar .logo h1 { font-family: var(--serif); font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
      .sidebar .logo span { font-family: var(--mono); font-size: 10px; color: var(--accent-deep); display: block; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.16em; }
      .sidebar nav { padding: 12px 10px; flex: 1; }
      .nav-item { display: flex; align-items: center; gap: 11px; padding: 10px 12px; border-radius: 4px; cursor: pointer; color: var(--muted, #5C5A57); font-family: var(--ui); font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.07em; transition: all 0.12s; border: none; background: none; width: 100%; text-align: left; }
      .nav-item:hover { background: var(--cream); color: var(--ink); }
      .nav-item.active { background: var(--accent-tint); color: var(--accent-deep); box-shadow: inset 3px 0 0 var(--accent); font-weight: 600; }
      .nav-item .ico { font-size: 15px; width: 20px; text-align: center; }
      .nav-sep { height: 1px; background: var(--line); margin: 10px 12px; }
      .sidebar-foot { padding: 14px 16px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; line-height: 1.8; }

      /* ── Main ── */
      .main { flex: 1; overflow-y: auto; padding: 0; }
      .page { display: none; padding: 32px 40px 56px; max-width: 1280px; }
      .page.active { display: block; }
      .page-head { margin-bottom: 28px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
      .page-head h2 { font-family: var(--serif); font-size: 38px; font-weight: 400; letter-spacing: -0.01em; line-height: 1.1; }
      .page-head .breadcrumb { font-family: var(--mono); font-size: 11px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.16em; margin-top: 8px; display: block; }
      .page-head .breadcrumb span { color: var(--accent-deep); }

      /* ── KPIs ── */
      .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 32px; }
      .kpi { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; }
      .kpi .n { font-family: var(--serif); font-size: 40px; font-weight: 400; line-height: 1; color: var(--ink); }
      .kpi .l { color: var(--mut); font-family: var(--mono); font-size: 10px; margin-top: 10px; text-transform: uppercase; letter-spacing: 0.14em; }
      .kpi.gold .n { color: var(--accent); } .kpi.green .n { color: var(--green); }
      .kpi.blue .n { color: var(--electric); } .kpi.purple .n { color: var(--accent); }
      .kpi.red .n { color: var(--red); }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
      @media (max-width: 900px) { .grid2 { grid-template-columns: 1fr; } }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 24px; margin-bottom: 24px; }
      .panel h3 { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em; color: var(--accent-deep); margin-bottom: 18px; }

      /* ── Machines ── */
      .m-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
      .m-card { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 20px; cursor: pointer; transition: all 0.15s; }
      .m-card:hover { border-color: var(--accent); background: rgba(107,53,194,0.03); }
      .m-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
      .m-icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; color: #fff; }
      .m-headtext { flex: 1; min-width: 0; }
      .m-name { font-family: var(--serif); font-weight: 500; font-size: 18px; line-height: 1.2; }
      .m-id { font-family: var(--mono); font-size: 10px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 2px; }
      .m-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      .m-note { color: var(--mut); font-size: 14px; line-height: 1.5; margin-bottom: 16px; font-family: 'Source Serif 4', Georgia, serif; }
      .m-foot { display: flex; justify-content: space-between; align-items: center; }
      .m-foot code { color: var(--electric); background: var(--cream); padding: 4px 9px; border-radius: 2px; font-family: var(--mono); font-size: 11px; }
      .m-status { font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 10px; }

      /* ── Machine detail view ── */
      .machine-detail { display: none; }
      .machine-detail.active { display: block; }
      .md-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
      .md-back { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 8px 14px; cursor: pointer; color: var(--ink); font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; }
      .md-back:hover { border-color: var(--accent); color: var(--accent); }
      .md-title { font-family: var(--serif); font-size: 26px; font-weight: 400; }
      .md-subtitle { font-size: 13px; color: var(--mut); }

      .md-stats { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
      .md-stat { padding: 8px 16px; border-radius: 2px; font-family: var(--mono); font-size: 12px; font-weight: 700; border: 1px solid; text-transform: uppercase; letter-spacing: 0.06em; }

      /* ── Tabs ── */
      .tabs { display: flex; gap: 0; margin-bottom: 20px; border: 1px solid var(--line); width: fit-content; }
      .tab { padding: 9px 20px; cursor: pointer; font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mut); background: var(--panel); border: none; border-right: 1px solid var(--line); transition: all 0.12s; }
      .tab:last-child { border-right: none; }
      .tab:hover { color: var(--ink); }
      .tab.active { background: var(--ink); color: var(--canvas); }

      /* ── Calendar strip ── */
      .cal-strip { display: flex; gap: 8px; margin-bottom: 18px; overflow-x: auto; padding-bottom: 4px; }
      .cal-day { min-width: 54px; text-align: center; padding: 10px 6px; background: var(--panel); border: 1px solid var(--line); border-radius: 2px; cursor: pointer; transition: all 0.12s; flex-shrink: 0; }
      .cal-day:hover { border-color: var(--accent); }
      .cal-day.today { border-color: var(--accent); background: var(--accent-tint); }
      .cal-day.has-items { border-color: var(--green); }
      .cal-day .dow { font-family: var(--mono); font-size: 9px; color: var(--mut); text-transform: uppercase; letter-spacing: 0.1em; }
      .cal-day .dom { font-family: var(--serif); font-size: 20px; font-weight: 400; margin-top: 2px; }
      .cal-day.today .dom { color: var(--accent-deep); }
      .cal-day .count-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); margin: 4px auto 0; }

      /* ── Filter pills ── */
      .filters { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
      .filter { padding: 8px 14px; border-radius: 2px; font-family: var(--ui); font-size: 13px; font-weight: 500; cursor: pointer; border: 1px solid var(--line); background: var(--panel); color: var(--ink); transition: all 0.12s; }
      .filter:hover { border-color: var(--accent); }
      .filter.active { background: var(--ink); color: var(--canvas); border-color: var(--ink); }
      .filter .cnt { opacity: 0.6; margin-left: 4px; font-variant-numeric: tabular-nums; }

      /* ── Content cards (entry list) ── */
      .entry-list { display: flex; flex-direction: column; gap: 0; }
      .entry-card { background: var(--panel); border-bottom: 1px solid var(--line); padding: 20px 4px; display: flex; align-items: flex-start; gap: 16px; transition: all 0.12s; }
      .entry-card:hover { background: rgba(107,53,194,0.04); }
      .entry-num { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--accent-deep); background: var(--accent-tint); padding: 4px 8px; border-radius: 2px; white-space: nowrap; margin-top: 2px; }
      .entry-body { flex: 1; min-width: 0; }
      .entry-title { font-family: var(--serif); font-weight: 400; font-size: 20px; line-height: 1.25; }
      .entry-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; align-items: center; }
      .chip { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 9px; border-radius: 2px; white-space: nowrap; color: #fff; }
      .chip.cat { background: var(--accent); }
      .chip.plat { background: var(--electric); }
      .chip.score { background: var(--green); }
      .chip.flag { background: var(--red); }
      .chip.vis { background: var(--navy); }
      .entry-status { display: flex; gap: 6px; flex-shrink: 0; margin-top: 2px; }
      .sbtn { font-family: var(--mono); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 7px 11px; border-radius: 2px; background: var(--panel); color: var(--mut); border: 1px solid var(--line); cursor: pointer; transition: all 0.12s; }
      .sbtn:hover { border-color: var(--accent); color: var(--accent); }
      .sbtn.cur { background: var(--ink); color: var(--canvas); border-color: var(--ink); }
      .sbtn:disabled { opacity: 0.4; cursor: wait; }

      /* ── Pillar bars ── */
      .pillar { margin-bottom: 14px; }
      .pillar .row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px; }
      .bar { height: 6px; background: var(--cream); border-radius: 999px; overflow: hidden; }
      .bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--electric)); border-radius: 999px; }

      /* ── Runs list ── */
      .runs { list-style: none; padding: 0; }
      .runs li { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
      .runs li:last-child { border-bottom: 0; }
      .runs .date { margin-left: auto; color: var(--mut); font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; }

      /* ── Tables ── */
      .data-table { width: 100%; border-collapse: collapse; font-size: 14px; }
      .data-table th { text-align: left; padding: 12px; color: var(--mut); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; border-bottom: 1px solid var(--line); }
      .data-table td { padding: 12px; border-bottom: 1px solid var(--line); }
      .data-table tr:last-child td { border-bottom: 0; }
      .data-table tr:hover td { background: rgba(107,53,194,0.04); }
      .data-table code { font-family: var(--mono); font-size: 12px; color: var(--electric); }

      /* ── Alerts ── */
      .attn-item { display: flex; gap: 12px; align-items: center; background: var(--cream); border: 1px solid var(--line); border-left: 3px solid var(--red); border-radius: 2px; padding: 12px 14px; font-size: 14px; margin-bottom: 10px; }
      .attn-item .t { font-weight: 600; flex: 1; }

      /* ── Skill card ── */
      .skill-card { background: var(--panel); border-bottom: 1px solid var(--line); padding: 16px 4px; display: flex; align-items: center; gap: 16px; }
      .skill-card:hover { background: rgba(107,53,194,0.04); }
      .skill-name { font-family: var(--mono); font-weight: 700; font-size: 13px; color: var(--accent-deep); min-width: 190px; }
      .skill-desc { color: var(--mut); font-size: 14px; flex: 1; line-height: 1.5; font-family: 'Source Serif 4', Georgia, serif; }

      /* ── CLI block (intentionally dark — terminal) ── */
      .cli-block { background: var(--term); border-radius: 2px; padding: 13px 16px; font-family: var(--mono); font-size: 13px; color: #8FE0B0; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; }
      .cli-label { font-family: var(--mono); font-size: 10px; color: var(--mut); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.12em; }

      /* ── Channel dot ── */
      .ch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }

      /* ── Toast ── */
      .toast { position: fixed; bottom: 24px; right: 24px; background: var(--ink); color: var(--canvas); font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 12px; padding: 14px 22px; border-radius: 2px; z-index: 999; display: none; box-shadow: 0 8px 28px rgba(0,0,0,0.18); }
      .toast.show { display: block; animation: slideUp 0.3s ease; }
      @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

      .empty { color: var(--mut); font-size: 14px; font-style: italic; padding: 12px 0; }
      .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
      .btn { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 10px 16px; color: var(--ink); font-family: var(--ui); font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.12s; display: inline-flex; align-items: center; gap: 6px; }
      .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

      /* ── Architecture diagram ── */
      .arch-flow { display: flex; align-items: stretch; gap: 0; flex-wrap: nowrap; margin: 20px 0; overflow-x: auto; padding-bottom: 8px; }
      .arch-node { flex: 0 0 auto; background: var(--cream); border: 1px solid var(--line); border-radius: 4px; padding: 16px 20px; text-align: center; min-width: 140px; display: flex; flex-direction: column; justify-content: center; }
      .arch-node .an-id { font-family: var(--mono); font-size: 10px; color: var(--accent-deep); font-weight: 700; letter-spacing: 0.1em; }
      .arch-node .an-name { font-family: var(--serif); font-size: 16px; font-weight: 400; margin-top: 6px; color: var(--ink); }
      .arch-node .an-sub { font-family: var(--mono); font-size: 9px; color: var(--mut); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.1em; }
      .arch-arrow { flex: 0 0 auto; display: flex; align-items: center; color: var(--accent); font-size: 22px; padding: 0 10px; }
    </style>
    <script is:inline>
      // Apply saved theme before paint to avoid a flash of light at night.
      (function () {
        try {
          var t = localStorage.getItem('cos-theme');
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="logo">
        <h1>CONTENT OS</h1>
        <span>The AI Automation Queen</span>
      </div>
      <nav>
        <button class="nav-item active" data-page="dashboard"><span class="ico">📊</span> Dashboard</button>
        <button class="nav-item" data-page="brain"><span class="ico">🧠</span> Second Brain</button>
        <button class="nav-item" data-page="inventory"><span class="ico">📦</span> Inventory</button>
        <button class="nav-item" data-page="architecture"><span class="ico">🏗️</span> Architecture</button>
        <button class="nav-item" data-page="machines"><span class="ico">⚙️</span> Machines</button>
        <button class="nav-item" data-page="calendar"><span class="ico">📅</span> Calendar</button>
        <button class="nav-item" data-page="crons"><span class="ico">⏰</span> Crons</button>
        <div class="nav-sep"></div>
        <button class="nav-item" data-page="agents"><span class="ico">🤖</span> Agents</button>
        <button class="nav-item" data-page="costs"><span class="ico">💰</span> Costs</button>
        <button class="nav-item" data-page="cli"><span class="ico">💻</span> CLI</button>
        <div class="nav-sep"></div>
        <button class="nav-item" data-page="alerts"><span class="ico">🔔</span> Alerts</button>
        <button class="nav-item" data-page="settings"><span class="ico">⚡</span> Settings</button>
      </nav>
      <div class="sidebar-foot">
        <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle night mode">
          <span class="tt-ico">🌙</span><span class="tt-label">Night mode</span>
        </button>
        tenant: <b>{d.tenant}</b><br>
        {new Date(d.generatedAt).toLocaleString()}
      </div>
    </aside>

    <!-- ── Main content ── -->
    <div class="main">

      <!-- ════ PAGE: Dashboard ════ -->
      <div class="page active" id="p-dashboard">
        <div class="page-head">
          <h2>Dashboard</h2>
          <span class="breadcrumb">Content OS / <span>Overview</span></span>
        </div>

        <div class="kpis">
          <div class="kpi"><div class="n">{d.kpis.total}</div><div class="l">Total pieces</div></div>
          <div class="kpi green"><div class="n">{d.kpis.ready}</div><div class="l">Ready to post</div></div>
          <div class="kpi gold"><div class="n">{d.kpis.scheduled}</div><div class="l">Scheduled</div></div>
          <div class="kpi purple"><div class="n">{d.kpis.posted}</div><div class="l">Posted</div></div>
          <div class="kpi red"><div class="n">{d.kpis.flagged}</div><div class="l">Need input</div></div>
          <div class="kpi blue"><div class="n">{d.kpis.withVisual}</div><div class="l">With visual</div></div>
        </div>

        <div class="grid2">
          <div>
            <div class="panel">
              <h3>Content Pillars</h3>
              {d.pillars.map((p) => (
                <div class="pillar">
                  <div class="row"><span>{p.name}</span><span>{p.n}</span></div>
                  <div class="bar"><span style={`width:${(p.n / maxPillar) * 100}%`}></span></div>
                </div>
              ))}
            </div>
            <div class="panel">
              <h3>Needs Your Input</h3>
              {d.flagged.length === 0 && <div class="empty">Nothing blocked.</div>}
              {d.flagged.map((e) => (
                <div class="attn-item">
                  <span class="entry-num">#{e.num}</span>
                  <span class="t">{e.title}</span>
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                </div>
              ))}
            </div>
          </div>
          <div>
            <div class="panel">
              <h3>Recent Runs</h3>
              <ul class="runs">
                {d.reports.slice(0, 10).map((r) => {
                  const meta = REPORT_META[r.type] || { label: r.type, icon: '📄' };
                  return <li><span>{meta.icon}</span><span>{meta.label}</span><span class="date">{r.date}</span></li>;
                })}
                {d.reports.length === 0 && <li class="empty">No reports yet.</li>}
              </ul>
            </div>
            <div class="panel">
              <h3>Control Room</h3>
              <div style="color:var(--mut); font-size:14px; margin-bottom:10px">
                {d.researchCount} research entries · {d.leads.active}/{d.leads.total} lead magnets active
              </div>
              <div class="links">
                <a class="btn" href="https://my.blotato.com" target="_blank">📤 Blotato queue</a>
                <a class="btn" href="https://github.com/the-ai-automation-queen/content-system" target="_blank">🧠 GitHub</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Second Brain ════ -->
      <div class="page" id="p-brain">
        <div class="page-head">
          <h2>Second Brain</h2>
          <span class="breadcrumb">Content OS / <span>Vault &amp; Research</span></span>
        </div>

        <div class="md-stats">
          <span class="md-stat" style={`color:var(--green);border-color:var(--green);background:transparent`}>Ready to Post <b>{d.kpis.ready}</b></span>
          <span class="md-stat" style={`color:var(--amber);border-color:var(--amber);background:transparent`}>Scheduled <b>{d.kpis.scheduled}</b></span>
          <span class="md-stat" style={`color:var(--accent);border-color:var(--accent);background:var(--accent-tint)`}>Posted <b>{d.kpis.posted}</b></span>
          <span class="md-stat" style={`color:var(--mut);border-color:var(--line);background:var(--cream)`}>Draft <b>{d.kpis.draft}</b></span>
        </div>

        <div class="filters" id="brain-filters">
          <button class="filter active" data-filter="all">All <span class="cnt">{d.entries.length}</span></button>
          {STATUSES.map((s) => {
            const cnt = d.entries.filter(e => e.status === s.key).length;
            return <button class="filter" data-filter={s.key}>{s.short} <span class="cnt">{cnt}</span></button>;
          })}
        </div>

        <div class="entry-list" id="brain-list">
          {d.entries.map((e) => (
            <div class="entry-card" data-entry-status={e.status}>
              <span class="entry-num">#{e.num}</span>
              <div class="entry-body">
                <div class="entry-title">{e.title}</div>
                <div class="entry-meta">
                  {platformChip(e.platform) && <span class="chip plat">{platformChip(e.platform)}</span>}
                  {e.pillar && <span class="chip cat">{e.pillar.split('(')[0].trim()}</span>}
                  {e.critic != null && <span class="chip score">{e.critic.toFixed(1)}</span>}
                  {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
                  {e.hasVisual && <span class="chip vis">Visual</span>}
                </div>
              </div>
              <div class="entry-status">
                {STATUSES.map((s) => (
                  <button class={`sbtn ${e.status === s.key ? 'cur' : ''}`} data-num={e.num} data-status={s.key}>{s.short}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ════ PAGE: Inventory ════ -->
      <div class="page" id="p-inventory">
        <div class="page-head">
          <h2>Inventory</h2>
          <span class="breadcrumb">Content OS / <span>Channels, offers &amp; tools</span></span>
        </div>

        <div class="panel">
          <h3>Channels</h3>
          <table class="data-table">
            <thead><tr><th></th><th>Channel</th><th>Role</th><th>Handle</th><th>Notes</th></tr></thead>
            <tbody>
              {d.channels.map((ch) => (
                <tr>
                  <td><span class="ch-dot" style={`background:${ch.connected ? 'var(--green)' : 'var(--red)'}`}></span></td>
                  <td><b>{ch.name}</b></td>
                  <td>{ch.role}</td>
                  <td style="font-size:13px;color:var(--mut)">{ch.handle}</td>
                  <td style="font-size:13px;color:var(--mut)">{ch.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="grid2">
          <div class="panel">
            <h3>Offers</h3>
            <div style="display:flex;flex-direction:column;gap:10px">
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">1.</span> Paid community / membership <span class="chip" style="background:var(--accent)">Core</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">2.</span> Digital products / courses</div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">3.</span> Corporate speaking / workshops <span class="chip" style="background:var(--accent)">High-ticket</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">4.</span> Packaged OS to sell <span class="chip" style="background:var(--electric)">Roadmap</span></div>
              <div style="display:flex;align-items:center;gap:10px;font-size:14px"><span style="color:var(--accent-deep);font-family:var(--mono)">5.</span> Affiliate / sponsorships <span class="chip" style="background:var(--mut)">Opportunistic</span></div>
            </div>
          </div>
          <div class="panel">
            <h3>Data Sources</h3>
            <div style="display:flex;flex-direction:column;gap:10px;font-size:14px">
              <div>📄 <b>research-notes.md</b> — {d.researchCount} research entries</div>
              <div>📁 <b>reports/</b> — {d.reports.length} reports</div>
              <div>📋 <b>inspiration-library/creators.csv</b> — 21 tracked creators</div>
              <div>🌐 Web research (Tavily / WebSearch) at runtime</div>
            </div>
          </div>
        </div>

        <div class="panel">
          <h3>Live-wiring gaps</h3>
          <table class="data-table">
            <thead><tr><th>Gap</th><th>What's needed</th><th>Unblocks</th></tr></thead>
            <tbody>
              <tr><td>HeyGen</td><td>HEYGEN_API_KEY + avatar/voice IDs</td><td style="color:var(--blue)">heygen (talking-head)</td></tr>
              <tr><td>TikTok</td><td>Connect account to Blotato</td><td style="color:var(--blue)">TikTok publishing</td></tr>
              <tr><td>ManyChat</td><td>MANYCHAT_API_KEY + IG automations</td><td style="color:var(--blue)">dm-responder (IG leads)</td></tr>
              <tr><td>Always-on host</td><td>VPS for crons + webhook</td><td style="color:var(--blue)">M05 + crons</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ════ PAGE: Architecture ════ -->
      <div class="page" id="p-architecture">
        <div class="page-head">
          <h2>Architecture</h2>
          <span class="breadcrumb">Content OS / <span>System map (Romain 8-step)</span></span>
        </div>

        <div class="panel">
          <h3>The pipeline</h3>
          <div class="arch-flow">
            <div class="arch-node"><div class="an-id">M01</div><div class="an-name">Signal Harvester</div><div class="an-sub">data layer</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M01</div><div class="an-name">Content Engine</div><div class="an-sub">scripts</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M02</div><div class="an-name">Visual Engine</div><div class="an-sub">visuals</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M02</div><div class="an-name">HeyGen</div><div class="an-sub">face</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M03</div><div class="an-name">Reels Factory</div><div class="an-sub">shorts</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M04</div><div class="an-name">Distribution</div><div class="an-sub">queue</div></div>
            <span class="arch-arrow">→</span>
            <div class="arch-node"><div class="an-id">M05</div><div class="an-name">DM Responder</div><div class="an-sub">leads</div></div>
          </div>
        </div>

        <div class="grid2">
          <div class="panel">
            <h3>Romain 8-step model</h3>
            <table class="data-table">
              <thead><tr><th>#</th><th>Step</th><th>Maps to</th></tr></thead>
              <tbody>
                <tr><td style="color:var(--gold2)">0</td><td>Inventory</td><td><code>inventory.md</code></td></tr>
                <tr><td style="color:var(--gold2)">1</td><td>Second Brain</td><td><code>content-vault.md</code>, <code>research-notes.md</code></td></tr>
                <tr><td style="color:var(--gold2)">2</td><td>Architecture</td><td><code>CLAUDE.md</code></td></tr>
                <tr><td style="color:var(--gold2)">3</td><td>AI Engine</td><td><code>skills/</code>, <code>positioning/</code></td></tr>
                <tr><td style="color:var(--gold2)">4</td><td>API &amp; Security</td><td><code>security.md</code></td></tr>
                <tr><td style="color:var(--gold2)">5</td><td>Incremental Build</td><td><code>ROADMAP.md</code></td></tr>
                <tr><td style="color:var(--gold2)">6</td><td>Hosting</td><td>Claude Code + GitHub</td></tr>
                <tr><td style="color:var(--gold2)">7</td><td>Deployment</td><td><code>skills/weekly-ops/</code></td></tr>
                <tr><td style="color:var(--gold2)">8</td><td>Agentics</td><td>The autonomous loop</td></tr>
              </tbody>
            </table>
          </div>
          <div class="panel">
            <h3>Source of truth</h3>
            <div style="display:flex;flex-direction:column;gap:12px;font-size:14px">
              <div>
                <div style="font-weight:600;margin-bottom:4px">Storage</div>
                <div style="color:var(--mut)">Markdown files ARE the database. Git is the version history.</div>
              </div>
              <div>
                <div style="font-weight:600;margin-bottom:4px">Runtime</div>
                <div style="color:var(--mut)">Claude Code (CLI, desktop, or web). No server, no build step.</div>
              </div>
              <div>
                <div style="font-weight:600;margin-bottom:4px">Sync</div>
                <div style="color:var(--mut)">Local machine → GitHub mirror. Local files win on conflict.</div>
              </div>
              <div>
                <div style="font-weight:600;margin-bottom:4px">Brand brain</div>
                <div style="color:var(--mut)">positioning/ + inspiration-library/ loaded before every draft.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Machines ════ -->
      <div class="page" id="p-machines">
        <div class="page-head">
          <h2>Machines</h2>
          <span class="breadcrumb">Content OS / <span>{d.machines.length} machines · {liveCount} live · {buildCount} en build · 0 à corriger</span></span>
        </div>

        <!-- Filter tabs -->
        <div class="filters" id="machine-filters" style="margin-bottom:12px">
          <button class="filter active" data-mfilter="all">All <span class="cnt">{d.machines.length}</span></button>
          {machineGroups.map((g) => {
            const cnt = d.machines.filter(m => m.group === g).length;
            return <button class="filter" data-mfilter={g}>{g.split('(')[0].trim()} <span class="cnt">{cnt}</span></button>;
          })}
        </div>

        <!-- Search -->
        <div style="margin-bottom:20px">
          <input type="text" id="machine-search" placeholder="Rechercher..." style="width:280px;padding:8px 14px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font-size:14px;outline:none" />
        </div>

        <!-- Grouped machine grid -->
        <div id="machines-grid">
          {machineGroups.map((g) => {
            const groupMachines = d.machines.filter(m => m.group === g);
            return (
              <div class="machine-group" data-group={g}>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;margin-top:20px">
                  <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--mut)">{g}</span>
                  <span style="font-size:11px;color:var(--mut)">{groupMachines.length}</span>
                  <span style="flex:1;height:1px;background:var(--line)"></span>
                </div>
                <div class="m-grid">
                  {groupMachines.map((m) => {
                    const s = MSTATUS[m.status] || MSTATUS.partial;
                    return (
                      <div class="m-card" data-machine={m.skill} data-machine-name={m.name} data-machine-id={m.id} data-machine-note={m.note} data-machine-status={m.status} data-machine-group={m.group}>
                        <div class="m-head">
                          <span class="m-icon" style={`background:${GROUP_COLOR[m.group] || '#6B35C2'}`}>{SKILL_ICON[m.skill] || '⚙️'}</span>
                          <div class="m-headtext">
                            <div class="m-name">{m.name}</div>
                            <div class="m-id">{m.id} · {m.group.split('(')[0].trim()}</div>
                          </div>
                          <span class="m-dot" style={`background:${s.c}`}></span>
                        </div>
                        <div class="m-note">{m.note}</div>
                        <div class="m-foot">
                          <code>{m.skill}</code>
                          <span class="m-status" style={`color:${s.c}`}>{s.t}</span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Machine detail (hidden until click) -->
        <div class="machine-detail" id="machine-detail">
          <div class="md-header">
            <button class="md-back" id="md-back">← Back</button>
            <div>
              <div class="md-title" id="md-title"></div>
              <div class="md-subtitle" id="md-subtitle"></div>
            </div>
          </div>

          <div class="md-stats" id="md-stats"></div>

          <div class="tabs" id="md-tabs">
            <button class="tab active" data-tab="content">Content</button>
            <button class="tab" data-tab="calendar">Calendar</button>
            <button class="tab" data-tab="run">Run Machine</button>
          </div>

          <div id="md-tab-content">
            <div class="filters" id="md-filters"></div>
            <div class="entry-list" id="md-entries"></div>
          </div>
          <div id="md-tab-calendar" style="display:none">
            <div class="cal-strip" id="md-cal-strip"></div>
            <div id="md-cal-entries" class="entry-list"></div>
          </div>
          <div id="md-tab-run" style="display:none">
            <div class="panel">
              <h3>Run this machine</h3>
              <p style="color:var(--mut); font-size:14px; margin-bottom:14px">Copy the command below and paste it in your terminal to run this machine.</p>
              <div class="cli-block">
                <span id="md-cmd"></span>
                <button class="btn" style="margin-left:12px;padding:4px 12px;font-size:12px" onclick="navigator.clipboard.writeText(document.getElementById('md-cmd').textContent).then(()=>showToast('Copied!'))">Copy</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Calendar ════ -->
      <div class="page" id="p-calendar">
        <div class="page-head">
          <h2>Editorial Calendar</h2>
          <span class="breadcrumb">Content OS / <span>Next 14 days</span></span>
        </div>

        <div style="display:flex;gap:12px;margin-bottom:16px;font-size:13px;color:var(--mut)">
          <span><span style="display:inline-block;width:9px;height:9px;border-radius:3px;background:var(--gold2);margin-right:5px;vertical-align:middle"></span>Scheduled</span>
          <span><span style="display:inline-block;width:9px;height:9px;border-radius:3px;background:var(--purple);margin-right:5px;vertical-align:middle"></span>Posted</span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:8px">
          {d.calendar.map((c) => (
            <div style={`background:var(--panel);border:1px solid ${c.isToday ? 'var(--gold)' : 'var(--line)'};border-radius:11px;padding:10px;min-height:90px;${c.isToday ? 'box-shadow:0 0 0 1px var(--gold) inset' : ''}`}>
              <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--mut);margin-bottom:8px">
                <span>{c.dow}</span>
                <span style={`font-weight:700;font-size:14px;color:${c.isToday ? 'var(--gold2)' : 'var(--ink)'}`}>{c.dom}</span>
              </div>
              {c.items.map((e) => (
                <div style={`font-size:12px;padding:4px 7px;border-radius:2px;margin-bottom:3px;line-height:1.3;${e.status === 'POSTED' ? 'background:var(--accent-tint);color:var(--accent-deep);border:1px solid var(--accent)' : 'background:transparent;color:var(--amber);border:1px solid var(--amber)'}`}>
                  #{e.num} {e.title}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- ════ PAGE: Crons ════ -->
      <div class="page" id="p-crons">
        <div class="page-head">
          <h2>Crons</h2>
          <span class="breadcrumb">Content OS / <span>Scheduled automations</span></span>
        </div>
        <div class="panel">
          <table class="data-table">
            <thead><tr><th>Machine</th><th>Schedule</th><th>Retry</th><th>Check</th></tr></thead>
            <tbody>
              {CRONS.map((c) => (
                <tr>
                  <td><b>{c.machine}</b> {c.name}</td>
                  <td>{c.schedule}</td>
                  <td>{c.retry}</td>
                  <td style="color:var(--mut)">{c.check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="panel" style="margin-top:16px">
          <h3>How to install</h3>
          <div class="cli-block" style="line-height:1.8;flex-direction:column;align-items:flex-start">
            <span>sed -i "s|__REPO__|$PWD|g" deploy/crontab.example</span>
            <span>crontab deploy/crontab.example</span>
            <span>crontab -l</span>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Agents ════ -->
      <div class="page" id="p-agents">
        <div class="page-head">
          <h2>Agents</h2>
          <span class="breadcrumb">Content OS / <span>{d.skills.length} skills</span></span>
        </div>

        <div style="color:var(--mut);font-size:14px;margin-bottom:18px">
          Each skill is a reusable instruction set in <code style="color:var(--blue)">skills/&lt;name&gt;/SKILL.md</code>. Run them via Claude Code or the CLI tab in Machines.
        </div>

        {d.skills.map((sk) => (
          <div class="skill-card">
            <span class="skill-name">{sk.name}</span>
            <span class="skill-desc">{sk.desc || 'No description'}</span>
          </div>
        ))}

        <div class="panel" style="margin-top:20px">
          <h3>Context skills (loaded before writing)</h3>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:14px">
            <div><code style="color:var(--gold2)">positioning/SKILL.md</code> — Brand positioning, voice, audience, the win-back-your-time promise, 6 content pillars</div>
            <div><code style="color:var(--gold2)">inspiration-library/SKILL.md</code> — 21 studied creators, 15 hook/format patterns, script application rules</div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Costs ════ -->
      <div class="page" id="p-costs">
        <div class="page-head">
          <h2>Costs</h2>
          <span class="breadcrumb">Content OS / <span>Monthly tool spend</span></span>
        </div>

        <div class="kpis" style="margin-bottom:24px">
          <div class="kpi gold"><div class="n">~${totalCost}</div><div class="l">Est. monthly</div></div>
          <div class="kpi"><div class="n">{COSTS.length}</div><div class="l">Tools</div></div>
          <div class="kpi green"><div class="n">{COSTS.filter(c=>c.plan.includes('Free')).length}</div><div class="l">Free tier</div></div>
        </div>

        <div class="panel">
          <table class="data-table">
            <thead><tr><th>Tool</th><th>Plan / Cost</th><th>Type</th><th>Note</th></tr></thead>
            <tbody>
              {COSTS.map((c) => (
                <tr>
                  <td><b>{c.tool}</b></td>
                  <td style={`color:${c.plan.includes('Free') ? 'var(--green)' : 'var(--gold2)'}`}>{c.plan}</td>
                  <td><span class="chip cat">{c.type}</span></td>
                  <td style="color:var(--mut)">{c.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- ════ PAGE: CLI ════ -->
      <div class="page" id="p-cli">
        <div class="page-head">
          <h2>CLI</h2>
          <span class="breadcrumb">Content OS / <span>Quick commands</span></span>
        </div>

        <div class="panel">
          <h3>Run a skill</h3>
          {d.machines.map((m) => (
            <div style="margin-bottom:12px">
              <div class="cli-label"><b>{m.name}</b> <span style="color:var(--mut)">({m.id})</span></div>
              <div class="cli-block">
                <span>claude -p "Run /{m.skill}"</span>
                <button class="btn copy-btn" style="padding:4px 12px;font-size:12px" data-copy={`claude -p "Run /${m.skill}"`}>Copy</button>
              </div>
            </div>
          ))}
        </div>

        <div class="grid2" style="margin-top:16px">
          <div class="panel">
            <h3>Full loop (weekly-ops)</h3>
            <div class="cli-block">
              <span>claude -p "Run /weekly-ops"</span>
              <button class="btn copy-btn" style="padding:4px 12px;font-size:12px" data-copy='claude -p "Run /weekly-ops"'>Copy</button>
            </div>
          </div>
          <div class="panel">
            <h3>Transcript (SupaData)</h3>
            <div class="cli-block" style="font-size:13px">
              <span>python skills/supadata-transcript/transcript.py "&lt;URL&gt;"</span>
              <button class="btn copy-btn" style="padding:4px 12px;font-size:12px" data-copy='python skills/supadata-transcript/transcript.py "URL"'>Copy</button>
            </div>
          </div>
        </div>

        <div class="panel" style="margin-top:16px">
          <h3>Dashboard</h3>
          <div style="margin-bottom:12px">
            <div class="cli-label">Start dev server</div>
            <div class="cli-block">
              <span>cd dashboard && npm run dev</span>
              <button class="btn copy-btn" style="padding:4px 12px;font-size:12px" data-copy="cd dashboard && npm run dev">Copy</button>
            </div>
          </div>
          <div>
            <div class="cli-label">Sync to GitHub</div>
            <div class="cli-block">
              <span>git add -A && git commit -m "update" && git push</span>
              <button class="btn copy-btn" style="padding:4px 12px;font-size:12px" data-copy='git add -A && git commit -m "update" && git push'>Copy</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ════ PAGE: Alerts ════ -->
      <div class="page" id="p-alerts">
        <div class="page-head">
          <h2>Alerts &amp; Monitoring</h2>
          <span class="breadcrumb">Content OS / <span>Telegram alerts</span></span>
        </div>
        <div class="panel">
          <h3>Alert channels</h3>
          <div class="attn-item" style="border-left-color:var(--green)">
            <span>🤖</span>
            <span class="t">Telegram Bot — run success/failure alerts</span>
            <span class="chip" style="background:var(--green)">{d.machines.length > 0 ? 'Configured' : 'Not set'}</span>
          </div>
          <div class="attn-item" style="border-left-color:var(--blue)">
            <span>📊</span>
            <span class="t">Daily summary — what ran, key figures</span>
            <span class="chip" style="background:var(--electric)">Via cron</span>
          </div>
          <div class="attn-item" style="border-left-color:var(--accent)">
            <span>🔒</span>
            <span class="t">Security monitoring — suspicious login detection</span>
            <span class="chip" style="background:var(--navy)">VPS only</span>
          </div>
        </div>
        <div class="panel" style="margin-top:16px">
          <h3>Flagged items needing your input</h3>
          {d.flagged.length === 0 && <div class="empty">All clear — nothing blocked.</div>}
          {d.flagged.map((e) => (
            <div class="attn-item">
              <span class="entry-num">#{e.num}</span>
              <span class="t">{e.title}</span>
              {e.flags.map((f) => <span class="chip flag">{FLAG_LABEL[f] || f}</span>)}
            </div>
          ))}
        </div>
      </div>

      <!-- ════ PAGE: Settings ════ -->
      <div class="page" id="p-settings">
        <div class="page-head">
          <h2>Settings</h2>
          <span class="breadcrumb">Content OS / <span>Configuration</span></span>
        </div>
        <div class="grid2">
          <div class="panel">
            <h3>Tenant</h3>
            <p style="color:var(--mut);font-size:14px;margin-bottom:10px">Current: <b style="color:var(--ink)">{d.tenant}</b></p>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
              {d.tenants.map((t) => (
                <a class={`btn ${(tenant === t || (tenant === 'root' && t === 'root')) ? 'cur' : ''}`}
                   href={t === 'root' ? '/' : `/?tenant=${t}`}
                   style={(tenant === t || (tenant === 'root' && t === 'root')) ? 'border-color:var(--gold);color:var(--gold2)' : ''}>
                  {t === 'root' ? 'Fatiha' : t}
                </a>
              ))}
            </div>
          </div>
          <div class="panel">
            <h3>API Keys Status</h3>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="display:flex;justify-content:space-between;font-size:14px">
                <span>HEYGEN_API_KEY</span>
                <span style={`color:${d.machines.find(m=>m.skill==='heygen')?.status === 'live' ? 'var(--green)' : 'var(--red)'}`}>
                  {d.machines.find(m=>m.skill==='heygen')?.status === 'live' ? 'Set' : 'Missing'}
                </span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:14px">
                <span>SUPADATA_API_KEY</span>
                <span style="color:var(--mut)">Check .env</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:14px">
                <span>TELEGRAM_BOT_TOKEN</span>
                <span style="color:var(--mut)">Check .env</span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:14px">
                <span>GHL_API_KEY</span>
                <span style="color:var(--mut)">Optional</span>
              </div>
            </div>
          </div>
        </div>
        <div class="panel" style="margin-top:16px">
          <h3>Lead Magnets</h3>
          <p style="color:var(--mut);font-size:14px">{d.leads.active}/{d.leads.total} active</p>
          <div style="margin-top:10px;display:flex;flex-direction:column;gap:6px">
            {d.leads.rows.map((r) => (
              <div style="display:flex;justify-content:space-between;align-items:center;font-size:14px;padding:6px 0;border-bottom:1px dashed var(--line)">
                <span><b>{r.keyword}</b> — {r.label}</span>
                <span style={`color:${r.active ? 'var(--green)' : 'var(--red)'};font-size:12px;font-weight:700`}>{r.active ? 'ACTIVE' : 'INACTIVE'}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <div class="toast" id="toast"></div>

    <!-- Data payload (safe JSON, avoids define:vars issues with special chars) -->
    <script id="app-data" type="application/json" set:html={dataPayload}></script>

    <script is:inline>
      const APP = JSON.parse(document.getElementById('app-data').textContent);
      const entries = APP.entries;
      const calendar = APP.calendar;
      const machines = APP.machines;

      function showToast(msg) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2500);
      }

      // ── Sidebar navigation ──
      document.querySelectorAll('.nav-item[data-page]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
          document.getElementById('p-' + btn.dataset.page).classList.add('active');
        });
      });

      // ── Brain filters ──
      document.querySelectorAll('#brain-filters .filter').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#brain-filters .filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.filter;
          document.querySelectorAll('#brain-list .entry-card').forEach(card => {
            card.style.display = (f === 'all' || card.dataset.entryStatus === f) ? 'flex' : 'none';
          });
        });
      });

      // ── Status buttons ──
      document.querySelectorAll('.sbtn').forEach(b => {
        b.addEventListener('click', async () => {
          if (b.classList.contains('cur')) return;
          b.disabled = true;
          try {
            const r = await fetch('/api/update', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }),
            });
            const j = await r.json();
            if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
            else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
          } catch (err) { alert('Failed: ' + err); b.disabled = false; }
        });
      });

      // ── Copy buttons ──
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(btn.dataset.copy).then(() => showToast('Copied!'));
        });
      });

      // ── Machine filter tabs ──
      document.querySelectorAll('#machine-filters .filter').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#machine-filters .filter').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.mfilter;
          document.querySelectorAll('.machine-group').forEach(g => {
            g.style.display = (f === 'all' || g.dataset.group === f) ? 'block' : 'none';
          });
        });
      });

      // ── Machine search ──
      document.getElementById('machine-search').addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase();
        document.querySelectorAll('.m-card').forEach(card => {
          const text = (card.dataset.machineName + ' ' + card.dataset.machineNote + ' ' + card.dataset.machine).toLowerCase();
          card.style.display = text.includes(q) ? '' : 'none';
        });
        // Show group headers that have visible cards
        document.querySelectorAll('.machine-group').forEach(g => {
          const visibleCards = g.querySelectorAll('.m-card[style=""], .m-card:not([style])');
          const hasHidden = g.querySelectorAll('.m-card[style*="none"]').length;
          const total = g.querySelectorAll('.m-card').length;
          g.style.display = (total - hasHidden > 0 || !q) ? 'block' : 'none';
        });
      });

      // ── Machine detail ──
      const STATUSES = [
        { key: 'DRAFT', short: 'Draft', color: '#5C5A57' },
        { key: 'READY TO POST', short: 'Ready', color: '#1E8E5A' },
        { key: 'SCHEDULED', short: 'Scheduled', color: '#B26A00' },
        { key: 'POSTED', short: 'Posted', color: '#6B35C2' },
      ];

      document.querySelectorAll('.m-card').forEach(card => {
        card.addEventListener('click', () => {
          const skill = card.dataset.machine;
          const name = card.dataset.machineName;
          const id = card.dataset.machineId;
          const note = card.dataset.machineNote;

          document.getElementById('machines-grid').style.display = 'none';
          document.getElementById('machine-filters').style.display = 'none';
          document.getElementById('machine-search').parentElement.style.display = 'none';
          const detail = document.getElementById('machine-detail');
          detail.classList.add('active');

          document.getElementById('md-title').textContent = name;
          document.getElementById('md-subtitle').textContent = id + ' · ' + note;
          document.getElementById('md-cmd').textContent = 'claude -p "Run /' + skill + '"';

          const mEntries = entries;
          const byStatus = {};
          STATUSES.forEach(s => { byStatus[s.key] = mEntries.filter(e => e.status === s.key).length; });

          const statsEl = document.getElementById('md-stats');
          statsEl.innerHTML = STATUSES.map(s =>
            '<span class="md-stat" style="color:' + s.color + ';border-color:' + s.color + '33;background:' + s.color + '11">' + s.short + ' <b>' + byStatus[s.key] + '</b></span>'
          ).join('');

          const filtersEl = document.getElementById('md-filters');
          filtersEl.innerHTML = '<button class="filter active" data-mf="all">All <span class="cnt">' + mEntries.length + '</span></button>' +
            STATUSES.map(s => '<button class="filter" data-mf="' + s.key + '">' + s.short + ' <span class="cnt">' + byStatus[s.key] + '</span></button>').join('');

          renderMachineEntries(mEntries);

          filtersEl.querySelectorAll('.filter').forEach(btn => {
            btn.addEventListener('click', () => {
              filtersEl.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              const f = btn.dataset.mf;
              const filtered = f === 'all' ? mEntries : mEntries.filter(e => e.status === f);
              renderMachineEntries(filtered);
            });
          });

          const calStrip = document.getElementById('md-cal-strip');
          calStrip.innerHTML = calendar.map(c =>
            '<div class="cal-day ' + (c.isToday ? 'today' : '') + ' ' + (c.items.length ? 'has-items' : '') + '">' +
              '<div class="dow">' + c.dow + '</div>' +
              '<div class="dom">' + c.dom + '</div>' +
              (c.items.length ? '<div class="count-dot"></div>' : '') +
            '</div>'
          ).join('');
        });
      });

      function escapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function renderMachineEntries(list) {
        const el = document.getElementById('md-entries');
        if (list.length === 0) { el.innerHTML = '<div class="empty">No entries.</div>'; return; }
        el.innerHTML = list.map(e => {
          const title = escapeHtml(e.title);
          const plat = e.platform ? escapeHtml(e.platform.split('(')[0].trim()) : '';
          const pillar = e.pillar ? escapeHtml(e.pillar.split('(')[0].trim()) : '';
          return '<div class="entry-card">' +
            '<span class="entry-num">#' + escapeHtml(e.num) + '</span>' +
            '<div class="entry-body">' +
              '<div class="entry-title">' + title + '</div>' +
              '<div class="entry-meta">' +
                (plat ? '<span class="chip plat">' + plat + '</span>' : '') +
                (pillar ? '<span class="chip cat">' + pillar + '</span>' : '') +
                (e.critic != null ? '<span class="chip score">' + e.critic.toFixed(1) + '</span>' : '') +
              '</div>' +
            '</div>' +
            '<div class="entry-status">' +
              STATUSES.map(s => '<button class="sbtn ' + (e.status === s.key ? 'cur' : '') + '" data-num="' + escapeHtml(e.num) + '" data-status="' + s.key + '">' + s.short + '</button>').join('') +
            '</div>' +
          '</div>';
        }).join('');
        el.querySelectorAll('.sbtn').forEach(b => {
          b.addEventListener('click', async () => {
            if (b.classList.contains('cur')) return;
            b.disabled = true;
            try {
              const r = await fetch('/api/update', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ num: b.dataset.num, status: b.dataset.status }) });
              const j = await r.json();
              if (j.ok) { showToast('Moved #' + j.num + ' → ' + j.status); setTimeout(() => location.reload(), 600); }
              else { alert('Failed: ' + (j.error || 'unknown')); b.disabled = false; }
            } catch (err) { alert('Failed: ' + err); b.disabled = false; }
          });
        });
      }

      document.getElementById('md-back').addEventListener('click', () => {
        document.getElementById('machine-detail').classList.remove('active');
        document.getElementById('machines-grid').style.display = 'block';
        document.getElementById('machine-filters').style.display = 'flex';
        document.getElementById('machine-search').parentElement.style.display = 'block';
      });

      document.querySelectorAll('#md-tabs .tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('#md-tabs .tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          ['content', 'calendar', 'run'].forEach(t => {
            document.getElementById('md-tab-' + t).style.display = t === tab.dataset.tab ? 'block' : 'none';
          });
        });
      });

      // ── Night-mode toggle (persisted) ──
      (function () {
        const btn = document.getElementById('themeToggle');
        if (!btn) return;
        const ico = btn.querySelector('.tt-ico');
        const label = btn.querySelector('.tt-label');
        function paint() {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          ico.textContent = dark ? '☀️' : '🌙';
          label.textContent = dark ? 'Day mode' : 'Night mode';
        }
        paint();
        btn.addEventListener('click', () => {
          const dark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (dark) {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('cos-theme', 'light'); } catch (e) {}
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('cos-theme', 'dark'); } catch (e) {}
          }
          paint();
        });
      })();
    </script>
  </body>
</html>
